<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mesin Kios Antrean Mandiri | <%= appName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=Space+Mono:wght@400;700&display=swap');
    * {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .font-mono {
      font-family: 'Space Mono', monospace;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between p-4 sm:p-8 select-none">

  <!-- Top Header Kiosk -->
  <header class="max-w-4xl mx-auto w-full flex items-center justify-between bg-slate-900/90 border border-slate-800 rounded-3xl px-6 py-4 backdrop-blur-xl shadow-2xl">
    <div class="flex items-center space-x-3.5">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-xl font-black text-white shadow-lg shadow-indigo-500/30">
        <i class="fas fa-wallet"></i>
      </div>
      <div>
        <h1 class="text-base sm:text-lg font-black text-white uppercase tracking-tight"><%= appName %></h1>
        <p class="text-[11px] text-slate-400 font-medium">Mesin Pengambilan Nomor Antrean Mandiri</p>
      </div>
    </div>

    <div class="flex items-center space-x-2">
      <a
        href="/antrean/display"
        target="_blank"
        class="px-3.5 py-2 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all border border-slate-700 flex items-center space-x-1.5"
      >
        <i class="fas fa-tv text-indigo-400"></i>
        <span class="hidden sm:inline">Layar TV</span>
      </a>
      <a
        href="/login"
        class="px-3.5 py-2 rounded-2xl bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 text-xs font-bold transition-all border border-indigo-500/30 flex items-center space-x-1.5"
      >
        <i class="fas fa-sign-in-alt"></i>
        <span>Login Anggota</span>
      </a>
    </div>
  </header>

  <!-- Main Kiosk Action Grid -->
  <main class="max-w-4xl mx-auto w-full my-auto py-6 space-y-6">
    <div class="text-center space-y-2">
      <span class="px-3.5 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-[11px] font-extrabold uppercase tracking-widest">
        Selamat Datang di Loket Pelayanan
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
        Sentuh Layar untuk Mengambil Tiket
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 max-w-lg mx-auto">
        Silakan pilih keperluan transaksi Anda di bawah ini untuk mendapatkan nomor antrean loket
      </p>
    </div>

    <!-- 4 Big Touchscreen Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      
      <!-- Option 1: DAFTAR ANGGOTA BARU (Prefix C) - Prioritas Calon Anggota -->
      <button
        type="button"
        onclick="openTakeModal('DAFTAR', '📝 Pendaftaran Anggota Baru / Buka Tabungan', 'C')"
        class="p-6 rounded-3xl bg-gradient-to-br from-indigo-900/50 via-slate-900 to-indigo-950 border-2 border-indigo-500/40 hover:border-indigo-400 active:scale-95 transition-all text-left group shadow-xl hover:shadow-indigo-500/10 flex items-center justify-between"
      >
        <div class="space-y-1.5">
          <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-xl font-black shadow-lg shadow-indigo-600/30 group-hover:scale-110 transition-transform">
            C
          </div>
          <h3 class="text-base sm:text-lg font-black text-white group-hover:text-indigo-300 transition-colors">
            Daftar Anggota Baru
          </h3>
          <p class="text-xs text-slate-400">
            Pembukaan rekening tabungan & calon anggota
          </p>
        </div>
        <i class="fas fa-chevron-right text-slate-600 group-hover:text-indigo-400 text-lg transition-transform group-hover:translate-x-1"></i>
      </button>

      <!-- Option 2: SETOR TUNAI (Prefix A) -->
      <button
        type="button"
        onclick="openTakeModal('SETOR', '📥 Setor Tunai Tabungan', 'A')"
        class="p-6 rounded-3xl bg-gradient-to-br from-emerald-900/40 via-slate-900 to-emerald-950 border-2 border-emerald-500/40 hover:border-emerald-400 active:scale-95 transition-all text-left group shadow-xl hover:shadow-emerald-500/10 flex items-center justify-between"
      >
        <div class="space-y-1.5">
          <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl font-black shadow-lg shadow-emerald-600/30 group-hover:scale-110 transition-transform">
            A
          </div>
          <h3 class="text-base sm:text-lg font-black text-white group-hover:text-emerald-300 transition-colors">
            Setor Tunai (Nabung)
          </h3>
          <p class="text-xs text-slate-400">
            Penyetoran simpanan uang tunai ke kasir
          </p>
        </div>
        <i class="fas fa-chevron-right text-slate-600 group-hover:text-emerald-400 text-lg transition-transform group-hover:translate-x-1"></i>
      </button>

      <!-- Option 3: TARIK TUNAI (Prefix B) -->
      <button
        type="button"
        onclick="openTakeModal('TARIK', '📤 Tarik Tunai Tabungan', 'B')"
        class="p-6 rounded-3xl bg-gradient-to-br from-amber-900/40 via-slate-900 to-amber-950 border-2 border-amber-500/40 hover:border-amber-400 active:scale-95 transition-all text-left group shadow-xl hover:shadow-amber-500/10 flex items-center justify-between"
      >
        <div class="space-y-1.5">
          <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl font-black shadow-lg shadow-amber-500/30 group-hover:scale-110 transition-transform">
            B
          </div>
          <h3 class="text-base sm:text-lg font-black text-white group-hover:text-amber-300 transition-colors">
            Tarik Tunai Saldo
          </h3>
          <p class="text-xs text-slate-400">
            Pencairan dana uang tabungan anggota
          </p>
        </div>
        <i class="fas fa-chevron-right text-slate-600 group-hover:text-amber-400 text-lg transition-transform group-hover:translate-x-1"></i>
      </button>

      <!-- Option 4: CUSTOMER SERVICE (Prefix D) -->
      <button
        type="button"
        onclick="openTakeModal('CS', '💼 Layanan Informasi & Konsultasi CS', 'D')"
        class="p-6 rounded-3xl bg-gradient-to-br from-purple-900/40 via-slate-900 to-purple-950 border-2 border-purple-500/40 hover:border-purple-400 active:scale-95 transition-all text-left group shadow-xl hover:shadow-purple-500/10 flex items-center justify-between"
      >
        <div class="space-y-1.5">
          <div class="w-12 h-12 rounded-2xl bg-purple-600 text-white flex items-center justify-center text-xl font-black shadow-lg shadow-purple-600/30 group-hover:scale-110 transition-transform">
            D
          </div>
          <h3 class="text-base sm:text-lg font-black text-white group-hover:text-purple-300 transition-colors">
            Informasi & CS
          </h3>
          <p class="text-xs text-slate-400">
            Konsultasi buku tabungan, akun & pengaduan
          </p>
        </div>
        <i class="fas fa-chevron-right text-slate-600 group-hover:text-purple-400 text-lg transition-transform group-hover:translate-x-1"></i>
      </button>

    </div>
  </main>

  <!-- Modal Konfirmasi Ambil Tiket Antrean (Opsional Nama & WA) -->
  <div id="takeModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-sm w-full shadow-2xl text-left space-y-4 animate-fade-in">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center space-x-2.5">
          <div id="modalPrefixBadge" class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-sm">
            -
          </div>
          <h3 class="text-sm font-black text-white" id="modalServiceTitle">Ambil Antrean</h3>
        </div>
        <button type="button" onclick="closeTakeModal()" class="text-slate-400 hover:text-white w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center">
          <i class="fas fa-times text-xs"></i>
        </button>
      </div>

      <form action="/antrean/ambil" method="post" class="space-y-3.5">
        <input type="hidden" name="serviceType" id="modalServiceInput" value="DAFTAR" />

        <div>
          <label class="block text-[11px] font-bold text-slate-300 mb-1">Nama Lengkap (Opsional)</label>
          <input
            type="text"
            name="guestName"
            placeholder="Contoh: Budi Santoso"
            class="w-full px-3.5 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-300 mb-1">Nomor WhatsApp (Opsional)</label>
          <input
            type="tel"
            name="guestPhone"
            placeholder="Contoh: 081234567890"
            class="w-full px-3.5 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
          />
        </div>

        <button
          type="submit"
          class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 active:scale-98 text-white font-black text-xs shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center space-x-2"
        >
          <i class="fas fa-print"></i>
          <span>CETAK TIKET ANTREAN SEKARANG</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Bottom Kiosk Footer Status -->
  <footer class="max-w-4xl mx-auto w-full bg-slate-900/60 border border-slate-800 rounded-2xl px-6 py-3 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Antrean Menunggu Saat Ini: <b class="text-white"><%= totalWaiting %> Orang</b></span>
    </div>
    <div class="font-mono text-[11px] text-slate-500">
      Status Sedang Dipanggil: <b class="text-amber-400"><%= currentlyServing ? currentlyServing.queueNumber : '-' %></b>
    </div>
  </footer>

  <script>
    function openTakeModal(serviceType, title, prefix) {
      document.getElementById('modalServiceInput').value = serviceType;
      document.getElementById('modalServiceTitle').textContent = title;
      document.getElementById('modalPrefixBadge').textContent = prefix;

      const modal = document.getElementById('takeModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeTakeModal() {
      const modal = document.getElementById('takeModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>
</body>
</html>
