<%- include("../../layouts/header", { title: "Manajemen Anggota" }) %>

<div class="space-y-4">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h2 class="text-base sm:text-lg font-bold text-slate-800">Daftar Seluruh Anggota Tabungan</h2>
      <p class="text-xs text-slate-400">Total <%= members.length %> anggota tabungan terdaftar</p>
    </div>
    <a
      href="/admin/members/new"
      class="inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all"
    >
      <i class="fas fa-plus text-xs"></i>
      <span>Tambah Anggota Baru</span>
    </a>
  </div>

  <!-- Search Input -->
  <div class="relative">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
      <i class="fas fa-search text-xs"></i>
    </span>
    <input
      type="text"
      id="adminMemberSearch"
      placeholder="Cari berdasarkan nama, nomor rekening, no. WA, atau email..."
      class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 bg-white card-shadow focus:outline-none"
    />
  </div>

  <!-- Member List Cards (Responsive: 1 col on mobile, 2 on tablet, 3 on PC) -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
    <% if (members.length === 0) { %>
    <div class="py-12 text-center">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-lg">
        <i class="fas fa-users"></i>
      </div>
      <p class="text-xs font-bold text-slate-700">Belum ada anggota terdaftar</p>
      <p class="text-[11px] text-slate-400 mt-0.5">Daftarkan anggota pertama Anda sekarang.</p>
    </div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <% members.forEach(m => { %>
      <div
        class="admin-member-card p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition-all flex flex-col justify-between space-y-3"
        data-search="<%= (m.name + ' ' + (m.accountNumber || '') + ' ' + (m.phone || '') + ' ' + m.email).toLowerCase() %>"
      >
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-extrabold text-sm border border-indigo-100 shrink-0">
              <%= m.name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h4 class="text-xs font-bold text-slate-800"><%= m.name %></h4>
              <span class="font-mono text-[10px] font-bold text-indigo-600 px-1.5 py-0.2 rounded bg-indigo-50 inline-block mt-0.5">
                <%= m.accountNumber || ('TBG-2026-' + String(m.id).padStart(4, '0')) %>
              </span>
            </div>
          </div>

          <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-bold">
            ANGGOTA
          </span>
        </div>

        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
          <div class="flex items-center space-x-1 text-slate-500 text-[11px] truncate max-w-[170px]">
            <i class="fab fa-whatsapp text-emerald-500"></i>
            <span><%= m.phone || '-' %></span>
          </div>

          <div class="flex items-center space-x-1.5 shrink-0">
            <a
              href="/admin/members/<%= m.id %>/edit"
              class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 flex items-center justify-center text-[11px] transition-all"
              title="Edit Anggota"
            >
              <i class="fas fa-pen"></i>
            </a>

            <form action="/admin/members/<%= m.id %>/delete" method="post" onsubmit="return confirm('Hapus anggota ini?')">
              <button
                type="submit"
                class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 flex items-center justify-center text-[11px] transition-all"
                title="Hapus Anggota"
              >
                <i class="fas fa-trash"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById("adminMemberSearch");
  const cards = document.querySelectorAll(".admin-member-card");

  searchInput?.addEventListener("input", function () {
    const q = this.value.toLowerCase().trim();
    cards.forEach(card => {
      const text = card.getAttribute("data-search") || "";
      if (!q || text.includes(q)) {
        card.style.display = "flex";
      } else {
        card.style.display = "none";
      }
    });
  });
</script>

<%- include("../../layouts/footer") %>
