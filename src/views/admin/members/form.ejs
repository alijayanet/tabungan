<%- include("../../layouts/header", { title: mode === "create" ? "Tambah Anggota" : "Edit Anggota" }) %>

<div class="space-y-4 max-w-2xl mx-auto">
  <div class="bg-white rounded-3xl p-6 sm:p-8 card-shadow border border-slate-100">
    <div class="flex items-center space-x-3 mb-6">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg border border-indigo-100">
        <i class="fas <%= mode === 'create' ? 'fa-user-plus' : 'fa-user-edit' %>"></i>
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold text-slate-800">
          <%= mode === "create" ? "Tambah Anggota Tabungan Baru" : "Edit Data Anggota" %>
        </h2>
        <p class="text-xs text-slate-400">
          <%= mode === "create" ? "Nomor rekening otomatis dibuat oleh sistem" : "Perbarui data profil anggota" %>
        </p>
      </div>
    </div>

    <form
      action="<%= mode === 'create' ? '/admin/members' : ('/admin/members/' + member.id) %>"
      method="post"
      class="space-y-4"
    >
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Nama Lengkap</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <i class="fas fa-user text-xs"></i>
          </span>
          <input
            type="text"
            name="name"
            required
            value="<%= member.name %>"
            placeholder="Masukkan nama lengkap anggota"
            class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Alamat Email</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="far fa-envelope text-xs"></i>
            </span>
            <input
              type="email"
              name="email"
              required
              value="<%= member.email %>"
              placeholder="nama@email.com"
              class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Nomor WhatsApp</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="fab fa-whatsapp text-xs"></i>
            </span>
            <input
              type="text"
              name="phone"
              value="<%= member.phone || '' %>"
              placeholder="Contoh: 62812xxxxxx"
              class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">
          Kata Sandi / PIN
          <% if (mode === "edit") { %>
          <span class="text-[10px] text-slate-400 font-normal">(kosongkan jika tidak ingin mengubah)</span>
          <% } %>
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <i class="fas fa-lock text-xs"></i>
          </span>
          <input
            type="password"
            name="password"
            <%= mode === "create" ? "required" : "" %>
            placeholder="••••••••"
            class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-4 border-t border-slate-100">
        <a
          href="/admin/members"
          class="py-3 rounded-2xl border border-slate-200 text-slate-700 text-xs font-bold text-center hover:bg-slate-50 active:scale-95 transition-all"
        >
          Batal
        </a>
        <button
          type="submit"
          class="py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-98 text-white text-xs font-bold shadow-lg shadow-indigo-600/20 transition-all"
        >
          <%= mode === "create" ? "Daftarkan Anggota" : "Simpan Perubahan" %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include("../../layouts/footer") %>
