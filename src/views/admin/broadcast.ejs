<%- include("../layouts/header", { title: "Broadcast WhatsApp" }) %>

<div class="space-y-6 max-w-3xl mx-auto">
  <div class="bg-white rounded-3xl p-6 sm:p-8 card-shadow border border-slate-100">
    <div class="flex items-center space-x-3 mb-6">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl border border-emerald-100 shrink-0">
        <i class="fab fa-whatsapp"></i>
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold text-slate-800">Broadcast Pesan WhatsApp Massal</h2>
        <p class="text-xs text-slate-400">Kirim pengumuman resmi ke seluruh nomor WhatsApp anggota terdaftar</p>
      </div>
    </div>

    <!-- Alert / Status -->
    <% if (error) { %>
    <div class="mb-4 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center space-x-2.5">
      <i class="fas fa-exclamation-circle text-rose-500 text-sm shrink-0"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <% if (success) { %>
    <div class="mb-4 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center space-x-2.5">
      <i class="fas fa-check-circle text-emerald-500 text-base shrink-0"></i>
      <span><%= success %></span>
    </div>
    <% } %>

    <!-- Connection Indicator -->
    <div class="p-4 rounded-2xl mb-6 flex items-center justify-between <%= waStatus.status === 'open' ? 'bg-emerald-50 border border-emerald-200 text-emerald-900' : 'bg-amber-50 border border-amber-200 text-amber-900' %>">
      <div class="flex items-center space-x-2.5 text-xs font-bold">
        <span class="w-2.5 h-2.5 rounded-full <%= waStatus.status === 'open' ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500' %>"></span>
        <span>Status Bot: <%= waStatus.status === 'open' ? 'Terhubung & Siap Kirim' : 'Belum Terhubung' %></span>
      </div>
      <span class="text-xs font-semibold">Target: <b><%= membersCount %> Anggota</b></span>
    </div>

    <form action="/admin/broadcast" method="post" class="space-y-4" onsubmit="return confirm('Kirimkan pesan pengumuman ini ke <%= membersCount %> nomor WhatsApp anggota?')">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Isi Pesan Pengumuman</label>
        <textarea
          name="message"
          rows="6"
          required
          placeholder="Tulis pesan pengumuman di sini... Contoh: Diberitahukan bahwa loket penarikan tabungan libur pada hari Senin tanggal..."
          class="modern-input w-full p-4 rounded-2xl text-xs text-slate-800 focus:outline-none"
        ></textarea>
        <p class="text-[11px] text-slate-400 mt-1">
          *Pesan akan otomatis diawali salam pembuka dengan nama masing-masing anggota.
        </p>
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
        <a href="/admin/dashboard" class="py-3 px-5 rounded-2xl border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-50 transition-all">
          Kembali
        </a>

        <button
          type="submit"
          <%= waStatus.status !== 'open' ? 'disabled' : '' %>
          class="py-3.5 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-98 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-bold shadow-lg shadow-emerald-600/20 transition-all flex items-center space-x-2"
        >
          <i class="fas fa-paper-plane text-xs"></i>
          <span>Kirim Broadcast Sekarang</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include("../layouts/footer") %>
