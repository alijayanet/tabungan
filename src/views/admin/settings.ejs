<%- include("../layouts/header", { title: "Pengaturan" }) %>

<div class="space-y-4">
  <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100">
    <div class="flex items-center space-x-3 mb-4">
      <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-sm">
        <i class="fas fa-sliders-h"></i>
      </div>
      <div>
        <h2 class="text-sm font-bold text-slate-800">Pengaturan Aplikasi & Notifikasi</h2>
        <p class="text-[11px] text-slate-400">Atur nama aplikasi dan format pesan WhatsApp otomatis</p>
      </div>
    </div>

    <form action="/admin/settings" method="post" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Nama Aplikasi Tabungan</label>
        <input
          type="text"
          name="appName"
          value="<%= appNameSetting %>"
          placeholder="Contoh: Tabungan Warga RT 01"
          class="modern-input w-full px-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Template WhatsApp Setoran</label>
        <p class="text-[10px] text-slate-400 mb-1.5 font-mono">
          Placeholder: [NAMA], [NO_REK], [NO_REF], [SALDO_AWAL], [NOMINAL], [KASIR], [SALDO_AKHIR], [WAKTU]
        </p>
        <textarea
          name="depositTemplate"
          rows="5"
          class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none font-mono"
        ><%= depositTemplate %></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Template WhatsApp Penarikan</label>
        <p class="text-[10px] text-slate-400 mb-1.5 font-mono">
          Placeholder: [NAMA], [NO_REK], [NO_REF], [SALDO_AWAL], [NOMINAL], [KASIR], [SALDO_AKHIR], [WAKTU]
        </p>
        <textarea
          name="withdrawTemplate"
          rows="5"
          class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none font-mono"
        ><%= withdrawTemplate %></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Template WA Pengajuan Penarikan (Admin)</label>
        <p class="text-[10px] text-slate-400 mb-1.5 font-mono">
          Placeholder: [NAMA], [PHONE], [NOMINAL], [SALDO], [KETERANGAN]
        </p>
        <textarea
          name="withdrawRequestTemplate"
          rows="3"
          class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none font-mono"
        ><%= withdrawRequestTemplate %></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Template WA Penolakan Penarikan (Anggota)</label>
        <p class="text-[10px] text-slate-400 mb-1.5 font-mono">
          Placeholder: [NAMA], [NOMINAL], [SALDO], [KETERANGAN]
        </p>
        <textarea
          name="withdrawRejectTemplate"
          rows="3"
          class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none font-mono"
        ><%= withdrawRejectTemplate %></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3.5 px-4 rounded-2xl fintech-gradient hover:opacity-95 active:scale-98 text-white text-xs font-bold shadow-lg shadow-indigo-950/20 transition-all flex items-center justify-center space-x-2"
      >
        <i class="fas fa-save text-xs"></i>
        <span>Simpan Perubahan Pengaturan</span>
      </button>
    </form>
  </div>
</div>

<%- include("../layouts/footer") %>
