<%- include("../../layouts/header", { title: "Manajemen Kasir" }) %>

<div class="space-y-4">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h2 class="text-base sm:text-lg font-bold text-slate-800">Daftar Petugas Kasir</h2>
      <p class="text-xs text-slate-400">Kelola akun kasir yang bertugas melayani setoran dan penarikan</p>
    </div>
    <a
      href="/admin/cashiers/new"
      class="inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all"
    >
      <i class="fas fa-plus text-xs"></i>
      <span>Tambah Kasir Baru</span>
    </a>
  </div>

  <!-- Cashier List / Table Card -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
    <div class="space-y-3">
      <% if (cashiers.length === 0) { %>
      <div class="py-12 text-center">
        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-lg">
          <i class="fas fa-cash-register"></i>
        </div>
        <p class="text-xs font-bold text-slate-700">Belum ada data kasir</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Tambahkan akun kasir untuk mulai mengoperasikan loket tabungan.</p>
      </div>
      <% } %>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <% cashiers.forEach(c => { %>
        <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition-all flex flex-col justify-between space-y-3">
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm border border-emerald-100 shrink-0">
                <%= c.name.charAt(0).toUpperCase() %>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-800"><%= c.name %></h4>
                <p class="text-[11px] text-slate-400 truncate max-w-[150px]"><%= c.email %></p>
              </div>
            </div>

            <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-[10px] font-bold">
              KASIR
            </span>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <div class="flex items-center space-x-1 text-slate-500 text-[11px]">
              <i class="fab fa-whatsapp text-emerald-500"></i>
              <span><%= c.phone || '-' %></span>
            </div>

            <div class="flex items-center space-x-1.5">
              <a
                href="/admin/cashiers/<%= c.id %>/edit"
                class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 flex items-center justify-center text-[11px] transition-all"
                title="Edit Data"
              >
                <i class="fas fa-pen"></i>
              </a>

              <form action="/admin/cashiers/<%= c.id %>/delete" method="post" onsubmit="return confirm('Hapus akun kasir ini?')">
                <button
                  type="submit"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 flex items-center justify-center text-[11px] transition-all"
                  title="Hapus Kasir"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include("../../layouts/footer") %>
