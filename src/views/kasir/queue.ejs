<%- include("../layouts/header", { title: "Manajemen Antrean Loket Kasir" }) %>

<div class="space-y-6">
  <!-- Top Stat Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 text-white shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-[10px] font-extrabold uppercase tracking-wider">
        Audio Voice Call Engine
      </span>
      <h2 class="text-xl sm:text-2xl font-black mt-1">Pemanggilan Antrean Loket</h2>
      <p class="text-xs text-slate-300 mt-0.5">Panggil antrean nasabah dengan suara otomatis & sinkronisasi layar TV</p>
    </div>

    <div class="flex items-center space-x-2">
      <a
        href="/antrean/display"
        target="_blank"
        class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white rounded-2xl text-xs font-bold transition-all shadow-lg shadow-emerald-600/20 flex items-center space-x-1.5"
      >
        <i class="fas fa-tv"></i>
        <span>Buka Layar TV Ruang Tunggu</span>
      </a>
      <button
        type="button"
        onclick="testVoiceEngine()"
        class="px-3.5 py-2.5 bg-white/10 hover:bg-white/20 active:scale-95 text-white rounded-2xl text-xs font-bold transition-all border border-white/10 flex items-center space-x-1.5"
      >
        <i class="fas fa-volume-up"></i>
        <span>Tes Suara</span>
      </button>
    </div>
  </div>

  <!-- 2-Column Responsive Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Column: Active Call Pad & Action Controls (7 cols on PC) -->
    <div class="lg:col-span-7 space-y-4">
      
      <!-- Current Serving Card -->
      <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Sedang Dilayani Saat Ini</span>
          <% if (currentCalling) { %>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold animate-pulse">
            ● Status: Panggilan Aktif
          </span>
          <% } else { %>
          <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold">
            Loket Kosong / Siaga
          </span>
          <% } %>
        </div>

        <% if (currentCalling) { %>
        <div class="p-6 rounded-3xl bg-slate-900 text-white text-center space-y-3 shadow-xl relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>

          <p class="text-xs text-indigo-300 font-bold uppercase tracking-widest">Nomor Antrean</p>
          <h1 class="text-6xl font-black font-mono tracking-tight text-amber-300 my-1" id="currentNumberText">
            <%= currentCalling.queueNumber %>
          </h1>
          <div class="flex items-center justify-center space-x-2 text-xs text-slate-300">
            <span class="font-bold"><%= currentCalling.serviceType === 'SETOR' ? '📥 Setor Tunai' : (currentCalling.serviceType === 'TARIK' ? '📤 Tarik Tunai' : '💼 Layanan Umum') %></span>
            <span>•</span>
            <span class="text-indigo-300 font-semibold"><%= currentCalling.member ? currentCalling.member.name : 'Anggota Tamu' %></span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">Tujuan: <b class="text-white"><%= currentCalling.counterName || 'Loket Kasir' %></b></p>
        </div>

        <!-- Action Buttons for Current Calling -->
        <div class="grid grid-cols-3 gap-2">
          <!-- Panggil Ulang -->
          <form action="/kasir/antrean/<%= currentCalling.id %>/recall" method="post" class="w-full">
            <button
              type="submit"
              onclick="playCallAudio('<%= currentCalling.queueNumber %>', '<%= currentCalling.counterName || 'Loket Kasir' %>')"
              class="w-full py-3 px-2 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center space-x-1.5"
            >
              <i class="fas fa-volume-up"></i>
              <span>Panggil Ulang</span>
            </button>
          </form>

          <!-- Selesai -->
          <form action="/kasir/antrean/<%= currentCalling.id %>/selesai" method="post" class="w-full">
            <button
              type="submit"
              class="w-full py-3 px-2 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center space-x-1.5"
            >
              <i class="fas fa-check"></i>
              <span>Selesai</span>
            </button>
          </form>

          <!-- Lewati / Skip -->
          <form action="/kasir/antrean/<%= currentCalling.id %>/lewati" method="post" class="w-full">
            <button
              type="submit"
              class="w-full py-3 px-2 rounded-2xl bg-slate-100 hover:bg-rose-50 text-slate-700 hover:text-rose-600 active:scale-95 text-xs font-bold transition-all flex items-center justify-center space-x-1.5"
            >
              <i class="fas fa-forward"></i>
              <span>Lewati</span>
            </button>
          </form>
        </div>

        <% } else { %>
        <div class="py-12 text-center text-slate-400 bg-slate-50 rounded-3xl border border-dashed border-slate-200">
          <i class="fas fa-microphone-slash text-3xl mb-2 text-slate-300"></i>
          <p class="text-xs font-bold text-slate-700">Belum ada antrean yang sedang dipanggil.</p>
          <p class="text-[11px] text-slate-400">Pilih jenis layanan lalu klik tombol panggil berikutnya di bawah.</p>
        </div>
        <% } %>

        <!-- Call Next Queue Controller Form -->
        <div class="pt-4 border-t border-slate-100">
          <form action="/kasir/antrean/panggil" method="post" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Pilih Antrean Layanan</label>
                <select name="serviceType" class="modern-input w-full px-3 py-2.5 rounded-2xl text-xs text-slate-800 font-bold bg-slate-50">
                  <option value="ALL">🌟 Semua Jenis (Urutan Masuk Terlama)</option>
                  <option value="SETOR">📥 Khusus Setor Tunai (A)</option>
                  <option value="TARIK">📤 Khusus Tarik Tunai (B)</option>
                  <option value="CS">💼 Khusus Layanan CS (C)</option>
                </select>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Nama Loket Tujuan</label>
                <input
                  type="text"
                  name="counterName"
                  value="Loket Kasir 1"
                  required
                  class="modern-input w-full px-3 py-2.5 rounded-2xl text-xs text-slate-800 font-bold bg-slate-50"
                />
              </div>
            </div>

            <button
              type="submit"
              class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 active:scale-98 text-white font-black text-sm shadow-xl shadow-emerald-600/25 transition-all flex items-center justify-center space-x-2"
            >
              <i class="fas fa-bullhorn text-base"></i>
              <span>PANGGIL ANTREAN BERIKUTNYA 🔊</span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right Column: Waiting Queue List (5 cols on PC) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-800">Daftar Antrean Menunggu</h3>
          <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-bold text-xs">
            <%= waitingList.length %> Antrean
          </span>
        </div>

        <% if (waitingList.length === 0) { %>
        <div class="py-12 text-center text-xs text-slate-400">
          <i class="fas fa-check-circle text-2xl text-emerald-400 mb-2"></i>
          <p class="font-bold text-slate-700">Tidak ada antrean menunggu</p>
          <p class="text-[11px] text-slate-400">Semua anggota telah selesai dilayani.</p>
        </div>
        <% } else { %>
        <div class="divide-y divide-slate-100 max-h-[380px] overflow-y-auto pr-1">
          <% waitingList.forEach((q, idx) => { %>
          <div class="py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-2xl <%= q.serviceType === 'SETOR' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : (q.serviceType === 'TARIK' ? 'bg-amber-50 text-amber-700 border-amber-100' : 'bg-indigo-50 text-indigo-700 border-indigo-100') %> border flex items-center justify-center font-mono font-black text-sm shrink-0">
                <%= q.queueNumber %>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-800"><%= q.member ? q.member.name : 'Anggota' %></h4>
                <p class="text-[10px] text-slate-400">
                  <%= q.serviceType === 'SETOR' ? 'Setoran Kas' : (q.serviceType === 'TARIK' ? 'Tarik Saldo' : 'CS') %> • 
                  <%= new Date(q.createdAt).toLocaleTimeString("id-ID", { hour: '2-digit', minute: '2-digit' }) %>
                </p>
              </div>
            </div>
            <span class="text-[10px] font-bold text-slate-400 bg-slate-50 px-2 py-1 rounded-lg">
              Urutan ke-<%= idx + 1 %>
            </span>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Web Audio & Speech Synthesis Engine -->
<script>
  // Chime Audio Generator via Web Audio API (Bel Bandara 3 Nada)
  function playAirportChime() {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const notes = [523.25, 659.25, 783.99]; // C5, E5, G5
      notes.forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime + (idx * 0.25));
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime + (idx * 0.25));
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (idx * 0.25) + 0.4);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(audioCtx.currentTime + (idx * 0.25));
        osc.stop(audioCtx.currentTime + (idx * 0.25) + 0.45);
      });
    } catch (e) {
      console.warn("Audio Context failed:", e);
    }
  }

  // Voice Call Text-To-Speech berbahasa Indonesia
  function speakQueue(queueNumber, counterName) {
    if (!window.speechSynthesis) return;

    // Pisahkan huruf dan angka agar dibaca jelas (misal: "A kosong kosong satu")
    const parts = queueNumber.split('-');
    const letter = parts[0] || 'A';
    const numDigits = (parts[1] || '').split('').map(d => {
      const dict = { '0': 'nol', '1': 'satu', '2': 'dua', '3': 'tiga', '4': 'empat', '5': 'lima', '6': 'enam', '7': 'tujuh', '8': 'delapan', '9': 'sembilan' };
      return dict[d] || d;
    }).join(' ');

    const textToSpeak = `Nomor antrean, ${letter}, ${numDigits}. Silakan menuju ke ${counterName || 'Loket Kasir'}.`;

    const utterance = new SpeechSynthesisUtterance(textToSpeak);
    utterance.lang = "id-ID";
    utterance.rate = 0.9;
    utterance.pitch = 1.0;

    // Ambil voice id-ID jika tersedia
    const voices = window.speechSynthesis.getVoices();
    const indonesianVoice = voices.find(v => v.lang && v.lang.includes("id"));
    if (indonesianVoice) {
      utterance.voice = indonesianVoice;
    }

    setTimeout(() => {
      window.speechSynthesis.speak(utterance);
    }, 850);
  }

  function playCallAudio(queueNumber, counterName) {
    playAirportChime();
    speakQueue(queueNumber, counterName);
  }

  function testVoiceEngine() {
    playCallAudio("A-001", "Loket Kasir 1");
  }

  // Auto-play jika ada query param ?called=X
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const calledNumber = urlParams.get('called');
    if (calledNumber) {
      setTimeout(() => {
        playCallAudio(calledNumber, "Loket Kasir 1");
      }, 300);
    }
  });
</script>

<%- include("../layouts/footer") %>
