<%- include("../../layouts/header", { title: "Penarikan Tunai Aman" }) %>

<div class="space-y-6">
  <!-- Top Stat Banner -->
  <div class="bg-gradient-to-r from-amber-600 via-rose-700 to-amber-700 rounded-3xl p-5 text-white shadow-lg flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2">
        <span class="px-2 py-0.5 rounded-full bg-white/20 text-white text-[10px] font-extrabold uppercase tracking-wider flex items-center space-x-1">
          <i class="fas fa-shield-alt text-[10px]"></i>
          <span>Secure Cashier Desk</span>
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black mt-1">Form Tarik Tunai Mandiri</h2>
      <p class="text-xs text-amber-100 mt-0.5">Penarikan aman terotentikasi QR ID anggota secara langsung</p>
    </div>
    <div class="text-right hidden sm:block">
      <span class="text-[11px] text-amber-200 uppercase font-semibold">Total Penarikan Hari Ini</span>
      <h3 class="text-xl font-black">
        Rp <%= (todayWithdrawTotal || 0).toLocaleString("id-ID") %>
      </h3>
    </div>
  </div>

  <!-- Responsive 2-Column Grid on Desktop -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Column: Security Scanner & Withdraw Form (7 cols on PC) -->
    <div class="lg:col-span-7 space-y-4">

      <% if (error) { %>
      <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center space-x-2.5">
        <i class="fas fa-exclamation-circle text-rose-500 text-sm shrink-0"></i>
        <span><%= error %></span>
      </div>
      <% } %>

      <% if (success && !lastTransaction) { %>
      <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center space-x-2.5">
        <i class="fas fa-check-circle text-emerald-500 text-base shrink-0"></i>
        <span><%= success %></span>
      </div>
      <% } %>

      <!-- State 1: Locked State (Menunggu QR ID Anggota) -->
      <div id="lockedCard" class="bg-white rounded-3xl p-8 card-shadow border border-slate-100 text-center space-y-4">
        <div class="w-16 h-16 rounded-3xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto text-2xl border border-amber-200 shadow-sm animate-pulse">
          <i class="fas fa-qrcode"></i>
        </div>

        <div>
          <h3 class="text-base font-bold text-slate-800">Otorisasi Keamanan Anggota</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
            Demi menjaga kerahasiaan saldo & keamanan dana, penarikan <b>hanya dapat dibuka dengan men-scan QR ID Anggota</b>.
          </p>
        </div>

        <!-- Tombol Scan Kamera Utama -->
        <button
          type="button"
          onclick="openScannerModal()"
          class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 to-rose-600 hover:from-amber-600 hover:to-rose-700 active:scale-98 text-white font-extrabold text-sm shadow-xl shadow-amber-500/25 transition-all flex items-center justify-center space-x-2"
        >
          <i class="fas fa-camera text-base"></i>
          <span>Scan QR ID Anggota Sekarang</span>
        </button>

        <!-- Manual QR / Rekening Input for Barcode Scanner Hardware -->
        <div class="pt-2 border-t border-slate-100 text-left">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
            Atau Gunakan USB Barcode/QR Scanner / Input No. Rekening:
          </label>
          <form onsubmit="handleManualQrSubmit(event)" class="flex gap-2">
            <div class="relative flex-1">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                <i class="fas fa-barcode text-xs"></i>
              </span>
              <input
                type="text"
                id="manualQrInput"
                placeholder="Scan / Ketik No. Rekening / ID..."
                autocomplete="off"
                class="modern-input w-full pl-9 pr-3 py-2.5 rounded-xl text-xs text-slate-800 focus:outline-none"
              />
            </div>
            <button
              type="submit"
              class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 active:scale-95 text-white rounded-xl text-xs font-bold transition-all"
            >
              Verifikasi
            </button>
          </form>
        </div>
      </div>

      <!-- State 2: Unlocked State (Form Penarikan Terbuka) -->
      <div id="unlockedCard" class="hidden bg-white rounded-3xl p-6 card-shadow border border-emerald-100 space-y-4">
        <!-- Header Sesi Aktif -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-bold text-emerald-800">Sesi Penarikan Terbuka</span>
          </div>
          <button
            type="button"
            onclick="lockDesk()"
            class="px-3 py-1 bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-500 rounded-xl text-[11px] font-bold transition-all flex items-center space-x-1"
          >
            <i class="fas fa-lock text-[10px]"></i>
            <span>Batal / Kunci Loket</span>
          </button>
        </div>

        <form action="/kasir/penarikan" method="post" class="space-y-4" id="withdrawForm" onsubmit="return validateWithdraw()">
          <input type="hidden" name="memberId" id="memberIdInput" value="" />

          <!-- Nominal Input -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Nominal Penarikan Tunai (Rp)</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-sm">Rp</span>
              <input
                type="number"
                name="amount"
                id="amountInput"
                min="1000"
                step="1000"
                required
                placeholder="0"
                oninput="calculateAfter()"
                class="modern-input w-full pl-12 pr-4 py-3 rounded-2xl text-slate-800 font-bold text-lg focus:outline-none"
              />
            </div>
          </div>

          <!-- Quick Amount Chips -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">Pecahan Cepat</label>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" onclick="setAmount(50000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">50.000</button>
              <button type="button" onclick="setAmount(100000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">100.000</button>
              <button type="button" onclick="setAmount(200000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">200.000</button>
              <button type="button" onclick="setAmount(500000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">500.000</button>
              <button type="button" onclick="setAmount(1000000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">1.000.000</button>
              <button type="button" onclick="setAmountMax()" class="py-2 px-1 rounded-xl bg-amber-50 border border-amber-200 text-xs font-extrabold text-amber-700 hover:bg-amber-100 active:scale-95 transition-all">Tarik Semua</button>
            </div>
          </div>

          <!-- Live Balance Sisa Calculation Box -->
          <div id="calcBox" class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200 text-xs flex justify-between text-slate-500">
            <span>Sisa Saldo Setelah Ditarik:</span>
            <span id="remainingBalance" class="font-black text-slate-900">Rp 0</span>
          </div>

          <!-- Description Input -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Catatan Penarikan (Opsional)</label>
            <textarea
              name="description"
              rows="2"
              placeholder="Catatan keperluan penarikan..."
              class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-3.5 px-4 rounded-2xl bg-amber-500 hover:bg-amber-600 active:scale-98 text-white text-xs font-extrabold shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center space-x-2"
          >
            <i class="fas fa-hand-holding-usd"></i>
            <span>Proses & Simpan Penarikan</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Right Column: Member Profile Preview & Privacy Notice (5 cols on PC) -->
    <div class="lg:col-span-5 space-y-4">
      <!-- Member Preview Card (Only visible when verified) -->
      <div id="memberPreviewCard" class="hidden bg-white rounded-3xl p-5 card-shadow border border-emerald-100 space-y-3">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-black text-base border border-emerald-100 shrink-0">
            <i class="fas fa-user-check"></i>
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-800" id="previewName">-</h4>
            <span class="font-mono text-[11px] font-bold text-indigo-700 px-2 py-0.5 rounded-md bg-indigo-50 border border-indigo-100 inline-block mt-0.5" id="previewAcc">-</span>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2 text-xs">
          <div class="flex justify-between text-slate-500">
            <span>Saldo Tersedia:</span>
            <span class="font-black text-emerald-700 text-sm" id="previewSaldo">Rp 0</span>
          </div>
          <div class="flex justify-between text-slate-500 text-[11px]">
            <span>Nomor WhatsApp:</span>
            <span class="font-semibold text-slate-700" id="previewPhone">-</span>
          </div>
        </div>
      </div>

      <!-- Zero-Trust Privacy Guidelines -->
      <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100 text-xs text-slate-600 space-y-2.5">
        <h4 class="font-bold text-slate-800 flex items-center">
          <i class="fas fa-shield-alt text-amber-500 mr-2"></i>
          Prosedur Keamanan Tarik Tunai
        </h4>
        <ul class="list-disc pl-4 space-y-1.5 text-[11px] text-slate-500 leading-relaxed">
          <li><b>Kerahasiaan Saldo</b>: Data saldo anggota terenkripsi dan hanya terbuka ketika QR ID anggota dipindai secara fisik.</li>
          <li><b>Verifikasi Kehadiran</b>: Anggota wajib menunjukkan QR ID dari aplikasi ponsel miliknya di loket kasir.</li>
          <li><b>Pencairan Tunai</b>: Serahkan fisik uang tunai setelah struk penarikan tercetak atau tersimpan.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Modal Scanner Kamera QR Code -->
<div id="scannerModal" class="fixed inset-0 modal-backdrop hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-5 max-w-sm w-full shadow-2xl relative animate-fade-in text-center">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm font-bold">
          <i class="fas fa-camera"></i>
        </div>
        <h3 class="text-sm font-bold text-slate-800">Scan QR ID Anggota</h3>
      </div>
      <button type="button" onclick="closeScannerModal()" class="text-slate-400 hover:text-slate-600 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center">
        <i class="fas fa-times text-xs"></i>
      </button>
    </div>

    <p class="text-[11px] text-slate-500 mb-3">Arahkan kamera ke QR ID Anggota di HP atau Kartu Tabungan</p>

    <!-- Scanner Viewport -->
    <div class="relative overflow-hidden rounded-2xl border-2 border-dashed border-amber-300 bg-slate-950 aspect-square flex items-center justify-center">
      <div id="qr-reader" class="w-full h-full"></div>
    </div>

    <div id="scannerStatus" class="mt-3 text-[11px] font-semibold text-slate-600">
      Mengaktifkan kamera...
    </div>

    <button
      type="button"
      onclick="closeScannerModal()"
      class="mt-4 w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all"
    >
      Tutup Kamera
    </button>
  </div>
</div>

<!-- Modal Struk Otomatis Jika Berhasil -->
<% if (lastTransaction) { %>
<div id="receiptModal" class="fixed inset-0 modal-backdrop flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-6 max-w-sm w-full shadow-2xl relative animate-fade-in text-center">
    <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-2 text-xl">
      <i class="fas fa-check-circle"></i>
    </div>
    <h3 class="text-base font-black text-slate-900">Penarikan Berhasil Diproses!</h3>
    <p class="text-xs text-slate-500 mb-3">Saldo tabungan anggota telah diperbarui</p>

    <!-- Mini Receipt Summary with Saldo Awal & Akhir -->
    <div class="bg-slate-50 rounded-2xl p-3.5 text-xs text-left space-y-2 border border-slate-200">
      <div class="flex justify-between">
        <span class="text-slate-400">Anggota</span>
        <span class="font-bold text-slate-800"><%= lastTransaction.member.name %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Saldo Awal</span>
        <span class="font-mono text-slate-600">Rp <%= (lastTransaction.saldoAwal || 0).toLocaleString("id-ID") %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Penarikan (-)</span>
        <span class="font-bold text-rose-600">- Rp <%= lastTransaction.amount.toLocaleString("id-ID") %></span>
      </div>
      <div class="flex justify-between pt-1.5 border-t border-slate-200">
        <span class="text-slate-700 font-bold">Sisa Saldo Akhir</span>
        <span class="font-black text-slate-900 text-sm">Rp <%= lastTransaction.saldoAkhir.toLocaleString("id-ID") %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 space-y-2">
      <a 
        href="/kasir/receipt/<%= lastTransaction.id %>" 
        target="_blank"
        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2"
      >
        <i class="fas fa-print"></i>
        <span>Cetak Struk (Printer Thermal)</span>
      </a>

      <% 
        const waText = encodeURIComponent(
          `*BUKTI PENARIKAN TABUNGAN*\n` +
          `No. Ref: TRX-${String(lastTransaction.id).padStart(6, '0')}\n` +
          `Nama: ${lastTransaction.member.name}\n` +
          `Saldo Awal: Rp ${(lastTransaction.saldoAwal || 0).toLocaleString('id-ID')}\n` +
          `Penarikan (-): Rp ${lastTransaction.amount.toLocaleString('id-ID')}\n` +
          `*Sisa Saldo: Rp ${lastTransaction.saldoAkhir.toLocaleString('id-ID')}*\n` +
          `Petugas: ${lastTransaction.cashierName}\n\n` +
          `Terima kasih telah menabung.`
        );
        const waLink = lastTransaction.member.phone ? `https://wa.me/${lastTransaction.member.phone.replace(/[^0-9]/g, '')}?text=${waText}` : null;
      %>

      <% if (waLink) { %>
      <a 
        href="<%= waLink %>" 
        target="_blank"
        class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2"
      >
        <i class="fab fa-whatsapp"></i>
        <span>Kirim Ulang via WhatsApp</span>
      </a>
      <% } %>

      <button 
        type="button" 
        onclick="document.getElementById('receiptModal').classList.add('hidden')"
        class="w-full py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-700"
      >
        Tutup & Transaksi Baru
      </button>
    </div>
  </div>
</div>
<% } %>

<script>
  let currentMemberSaldo = 0;
  let html5QrCode = null;

  function setAmount(val) {
    document.getElementById('amountInput').value = val;
    calculateAfter();
  }

  function setAmountMax() {
    if (currentMemberSaldo <= 0) return;
    document.getElementById('amountInput').value = currentMemberSaldo;
    calculateAfter();
  }

  function calculateAfter() {
    const amount = parseInt(document.getElementById('amountInput').value || 0, 10);
    const remainingEl = document.getElementById('remainingBalance');
    const rem = currentMemberSaldo - amount;

    if (rem < 0) {
      remainingEl.textContent = "Saldo Tidak Cukup!";
      remainingEl.className = "font-black text-rose-600";
    } else {
      remainingEl.textContent = "Rp " + rem.toLocaleString('id-ID');
      remainingEl.className = "font-black text-slate-900";
    }
  }

  function validateWithdraw() {
    const memberId = document.getElementById('memberIdInput').value;
    if (!memberId) {
      alert("Harap scan QR ID anggota terlebih dahulu!");
      return false;
    }
    const amount = parseInt(document.getElementById('amountInput').value || 0, 10);
    if (!amount || amount <= 0) {
      alert("Masukkan nominal yang valid!");
      return false;
    }
    if (amount > currentMemberSaldo) {
      alert("Nominal penarikan melebihi saldo anggota!");
      return false;
    }
    return true;
  }

  // Verifikasi QR ID ke Backend
  async function verifyQrCode(qrCode) {
    try {
      const res = await fetch('/kasir/api/verify-qr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ qrCode })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.message || "QR ID Anggota tidak valid!");
        return false;
      }

      // Berhasil diverifikasi -> Buka form penarikan
      const m = data.member;
      currentMemberSaldo = m.saldo;

      document.getElementById('memberIdInput').value = m.id;
      document.getElementById('previewName').textContent = m.name;
      document.getElementById('previewAcc').textContent = m.accountNumber;
      document.getElementById('previewPhone').textContent = m.phone;
      document.getElementById('previewSaldo').textContent = "Rp " + m.saldo.toLocaleString('id-ID');

      // Tampilkan Unlocked Card, Sembunyikan Locked Card
      document.getElementById('lockedCard').classList.add('hidden');
      document.getElementById('unlockedCard').classList.remove('hidden');
      document.getElementById('memberPreviewCard').classList.remove('hidden');

      // Reset nominal
      document.getElementById('amountInput').value = '';
      calculateAfter();

      // Focus ke nominal
      const amtInput = document.getElementById('amountInput');
      amtInput.focus();
      amtInput.scrollIntoView({ behavior: 'smooth', block: 'center' });

      return true;
    } catch (err) {
      alert("Terjadi kesalahan komunikasi dengan server: " + err.message);
      return false;
    }
  }

  function lockDesk() {
    document.getElementById('memberIdInput').value = '';
    currentMemberSaldo = 0;
    document.getElementById('amountInput').value = '';
    document.getElementById('unlockedCard').classList.add('hidden');
    document.getElementById('memberPreviewCard').classList.add('hidden');
    document.getElementById('lockedCard').classList.remove('hidden');
    document.getElementById('manualQrInput').value = '';
  }

  async function handleManualQrSubmit(e) {
    e.preventDefault();
    const qrVal = document.getElementById('manualQrInput').value.trim();
    if (!qrVal) return;
    await verifyQrCode(qrVal);
  }

  // Handle QR Scan Result from Camera
  async function handleQrScanSuccess(decodedText) {
    closeScannerModal();
    await verifyQrCode(decodedText);
  }

  function openScannerModal() {
    const modal = document.getElementById('scannerModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('scannerStatus').textContent = "Mengarahkan kamera...";

    if (!html5QrCode && window.Html5Qrcode) {
      html5QrCode = new Html5Qrcode("qr-reader");
    }

    if (html5QrCode) {
      html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 220, height: 220 } },
        (decodedText) => {
          handleQrScanSuccess(decodedText);
        },
        () => {}
      ).then(() => {
        document.getElementById('scannerStatus').textContent = "Kamera aktif. Arahkan ke QR ID Anggota.";
      }).catch(err => {
        document.getElementById('scannerStatus').innerHTML = `<span class="text-rose-600">Gagal membuka kamera: ${err}</span>`;
      });
    }
  }

  function closeScannerModal() {
    if (html5QrCode && html5QrCode.isScanning) {
      html5QrCode.stop().then(() => {
        html5QrCode.clear();
      }).catch(() => {});
    }
    const modal = document.getElementById('scannerModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

<%- include("../../layouts/footer") %>
