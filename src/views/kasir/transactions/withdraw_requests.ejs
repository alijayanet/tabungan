<%- include("../../layouts/header", { title: "Pusat Antrean Loket Kasir" }) %>

<div class="space-y-6">
  <!-- Page Title Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-5 text-white shadow-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-[10px] font-extrabold uppercase tracking-wider">
        Queue & Request Manager
      </span>
      <h2 class="text-lg sm:text-xl font-black mt-0.5">Pusat Antrean & Pengajuan Kasir</h2>
      <p class="text-xs text-slate-300">Kelola antrean tiket loket fisik dan persetujuan penarikan mandiri anggota</p>
    </div>
    <div class="flex items-center space-x-2">
      <a
        href="/antrean/display"
        target="_blank"
        class="px-3.5 py-2 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-md flex items-center space-x-1.5"
      >
        <i class="fas fa-tv"></i>
        <span>Layar TV Antrean</span>
      </a>
      <a
        href="/antrean"
        target="_blank"
        class="px-3.5 py-2 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all border border-white/10 flex items-center space-x-1.5"
      >
        <i class="fas fa-plus"></i>
        <span>Kios Tiket</span>
      </a>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="flex items-center space-x-2 border-b border-slate-200 pb-2">
    <button
      type="button"
      onclick="switchTab('loketTab', this)"
      class="tab-btn px-4 py-2 rounded-2xl font-bold text-xs bg-indigo-600 text-white shadow-md shadow-indigo-600/20 transition-all flex items-center space-x-1.5"
    >
      <i class="fas fa-ticket-alt"></i>
      <span>Antrean Loket / Kios Hari Ini</span>
      <span class="ml-1 px-1.5 py-0.2 rounded-full bg-white/20 text-[10px]"><%= (typeof loketQueues !== 'undefined' ? loketQueues.length : 0) %></span>
    </button>

    <button
      type="button"
      onclick="switchTab('requestsTab', this)"
      class="tab-btn px-4 py-2 rounded-2xl font-bold text-xs bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all flex items-center space-x-1.5"
    >
      <i class="fas fa-hand-holding-usd"></i>
      <span>Pengajuan Penarikan Online</span>
      <span class="ml-1 px-1.5 py-0.2 rounded-full bg-slate-300 text-slate-700 text-[10px]"><%= requests.length %></span>
    </button>
  </div>

  <!-- TAB 1: Antrean Loket / Kios Hari Ini -->
  <div id="loketTab" class="space-y-4">
    
    <!-- Panggilan Cepat Aktif -->
    <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl font-mono font-black border border-indigo-100">
          <%= (typeof currentCalling !== 'undefined' && currentCalling) ? currentCalling.queueNumber : '---' %>
        </div>
        <div>
          <span class="text-[10px] font-extrabold uppercase text-slate-400">Sedang Dipanggil:</span>
          <h3 class="text-base font-black text-slate-900">
            <%= (typeof currentCalling !== 'undefined' && currentCalling) ? (currentCalling.queueNumber + ' • ' + (currentCalling.member ? currentCalling.member.name : (currentCalling.notes || 'Pengunjung'))) : 'Belum ada panggilan aktif' %>
          </h3>
          <p class="text-xs text-slate-400 font-medium">
            <%= (typeof currentCalling !== 'undefined' && currentCalling) ? (currentCalling.counterName || 'Loket Kasir 1') : 'Klik tombol di bawah untuk memanggil antrean berikutnya' %>
          </p>
        </div>
      </div>

      <div class="flex items-center space-x-2 w-full md:w-auto">
        <% if (typeof currentCalling !== 'undefined' && currentCalling) { %>
        <form action="/kasir/antrean/<%= currentCalling.id %>/recall" method="post">
          <button
            type="submit"
            onclick="playCallAudio('<%= currentCalling.queueNumber %>', '<%= currentCalling.counterName || 'Loket Kasir 1' %>')"
            class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center space-x-1.5"
          >
            <i class="fas fa-volume-up"></i>
            <span>Panggil Ulang</span>
          </button>
        </form>

        <form action="/kasir/antrean/<%= currentCalling.id %>/selesai" method="post">
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center space-x-1.5"
          >
            <i class="fas fa-check"></i>
            <span>Selesai</span>
          </button>
        </form>
        <% } %>

        <form action="/kasir/antrean/panggil" method="post" class="flex-1 md:flex-none">
          <input type="hidden" name="serviceType" value="ALL" />
          <input type="hidden" name="counterName" value="Loket Kasir 1" />
          <button
            type="submit"
            class="w-full px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white text-xs font-black shadow-md flex items-center justify-center space-x-1.5"
          >
            <i class="fas fa-bullhorn"></i>
            <span>PANGGIL BERIKUTNYA 🔊</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Daftar Antrean Menunggu -->
    <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Daftar Antrean Menunggu (<%= (typeof loketQueues !== 'undefined' ? loketQueues.length : 0) %>)</h3>
      </div>

      <% if (typeof loketQueues === 'undefined' || loketQueues.length === 0) { %>
      <div class="py-10 text-center">
        <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-2 text-lg">
          <i class="fas fa-check-circle"></i>
        </div>
        <p class="text-xs font-bold text-slate-700">Tidak ada antrean loket yang menunggu.</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Ambil tiket dari kios antrean mandiri untuk mencoba.</p>
      </div>
      <% } else { %>
      <div class="divide-y divide-slate-100">
        <% loketQueues.forEach((q, idx) => { %>
        <div class="py-3 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-2xl font-mono font-black text-sm flex items-center justify-center <%= q.status === 'CALLING' ? 'bg-amber-100 text-amber-900 animate-pulse border border-amber-300' : 'bg-indigo-50 text-indigo-700 border border-indigo-100' %>">
              <%= q.queueNumber %>
            </div>
            <div>
              <h4 class="text-xs font-bold text-slate-800">
                <%= q.member ? q.member.name : (q.notes || 'Pengunjung') %>
              </h4>
              <p class="text-[10px] text-slate-400">
                <%= q.serviceType === 'DAFTAR' ? '📝 Pendaftaran Anggota' : (q.serviceType === 'SETOR' ? '📥 Setor Tunai' : (q.serviceType === 'TARIK' ? '📤 Tarik Tunai' : '💼 CS')) %> • 
                <%= new Date(q.createdAt).toLocaleTimeString("id-ID", { hour: '2-digit', minute: '2-digit' }) %>
              </p>
            </div>
          </div>

          <div class="flex items-center space-x-2">
            <% if (q.status === 'CALLING') { %>
            <span class="px-2 py-0.5 rounded-md bg-amber-100 text-amber-800 text-[10px] font-bold">
              Sedang Dipanggil
            </span>
            <% } else { %>
            <span class="text-[10px] font-bold text-slate-400 bg-slate-50 px-2 py-1 rounded-lg">
              Urutan ke-<%= idx + 1 %>
            </span>
            <% } %>

            <form action="/kasir/antrean/<%= q.id %>/recall" method="post">
              <button
                type="submit"
                onclick="playCallAudio('<%= q.queueNumber %>', 'Loket Kasir 1')"
                class="px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[11px] font-bold flex items-center space-x-1"
                title="Panggil Nomor Ini"
              >
                <i class="fas fa-volume-up text-xs"></i>
                <span>Panggil</span>
              </button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <!-- TAB 2: Pengajuan Penarikan Mandiri Online -->
  <div id="requestsTab" class="hidden space-y-3">
    <% if (requests.length === 0) { %>
    <div class="bg-white rounded-3xl p-8 card-shadow border border-slate-100 text-center">
      <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-2 text-lg">
        <i class="fas fa-check-double"></i>
      </div>
      <p class="text-xs font-bold text-slate-700">Semua Beres!</p>
      <p class="text-[11px] text-slate-400 mt-0.5">Tidak ada pengajuan penarikan online mandiri saat ini.</p>
    </div>
    <% } %>

    <% requests.forEach(r => { %>
    <div class="bg-white rounded-3xl p-4 card-shadow border border-slate-100 space-y-3">
      <div class="flex items-start justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0 border border-amber-100">
            <i class="fas fa-user"></i>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-800"><%= r.member.name %></h4>
            <p class="text-[11px] font-mono text-slate-400">
              <%= r.member.accountNumber || ('TBG-2026-' + String(r.member.id).padStart(4, '0')) %>
            </p>
          </div>
        </div>

        <div class="text-right">
          <span class="text-[10px] text-slate-400 uppercase font-semibold">Nominal</span>
          <p class="text-sm font-black text-rose-600">
            Rp <%= Math.abs(r.amount).toLocaleString("id-ID") %>
          </p>
        </div>
      </div>

      <div class="bg-slate-50 rounded-2xl p-3 text-xs space-y-1 border border-slate-100">
        <div class="flex justify-between text-[11px] text-slate-500">
          <span>Waktu Pengajuan:</span>
          <span class="font-semibold text-slate-700"><%= new Date(r.createdAt).toLocaleString("id-ID") %></span>
        </div>
        <div class="flex justify-between text-[11px] text-slate-500">
          <span>No. WhatsApp:</span>
          <span class="font-semibold text-slate-700"><%= r.member.phone || '-' %></span>
        </div>
        <% if (r.description) { %>
        <div class="pt-1 border-t border-slate-200/60 text-[11px]">
          <span class="text-slate-400">Catatan:</span>
          <p class="italic text-slate-600 mt-0.5"><%= r.description %></p>
        </div>
        <% } %>
      </div>

      <div class="grid grid-cols-2 gap-2 pt-1">
        <form action="/kasir/penarikan/<%= r.id %>/reject" method="post" onsubmit="return confirm('Yakin ingin menolak pengajuan ini?')">
          <button
            type="submit"
            class="w-full py-2.5 rounded-xl border border-rose-200 bg-rose-50 text-rose-700 text-xs font-bold hover:bg-rose-100 active:scale-95 transition-all flex items-center justify-center space-x-1.5"
          >
            <i class="fas fa-times"></i>
            <span>Tolak</span>
          </button>
        </form>

        <form action="/kasir/penarikan/<%= r.id %>/approve" method="post" onsubmit="return confirm('Setujui dan serahkan uang tunai?')">
          <button
            type="submit"
            class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold active:scale-95 shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center space-x-1.5"
          >
            <i class="fas fa-check"></i>
            <span>Setujui & Cairkan</span>
          </button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<!-- Web Audio & Speech Synthesis Engine -->
<script>
  function switchTab(tabId, btn) {
    document.getElementById('loketTab').classList.add('hidden');
    document.getElementById('requestsTab').classList.add('hidden');
    document.getElementById(tabId).classList.remove('hidden');

    const allButtons = document.querySelectorAll('.tab-btn');
    allButtons.forEach(b => {
      b.className = 'tab-btn px-4 py-2 rounded-2xl font-bold text-xs bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all flex items-center space-x-1.5';
    });

    btn.className = 'tab-btn px-4 py-2 rounded-2xl font-bold text-xs bg-indigo-600 text-white shadow-md shadow-indigo-600/20 transition-all flex items-center space-x-1.5';
  }

  function playAirportChime() {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const notes = [523.25, 659.25, 783.99];
      notes.forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime + (idx * 0.25));
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime + (idx * 0.25));
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (idx * 0.25) + 0.4);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(audioCtx.currentTime + (idx * 0.25));
        osc.stop(audioCtx.currentTime + (idx * 0.25) + 0.45);
      });
    } catch (e) {}
  }

  function speakQueue(queueNumber, counterName) {
    if (!window.speechSynthesis) return;

    const parts = queueNumber.split('-');
    const letter = parts[0] || 'A';
    const numDigits = (parts[1] || '').split('').map(d => {
      const dict = { '0': 'nol', '1': 'satu', '2': 'dua', '3': 'tiga', '4': 'empat', '5': 'lima', '6': 'enam', '7': 'tujuh', '8': 'delapan', '9': 'sembilan' };
      return dict[d] || d;
    }).join(' ');

    const textToSpeak = `Nomor antrean, ${letter}, ${numDigits}. Silakan menuju ke ${counterName || 'Loket Kasir'}.`;

    const utterance = new SpeechSynthesisUtterance(textToSpeak);
    utterance.lang = "id-ID";
    utterance.rate = 0.9;

    const voices = window.speechSynthesis.getVoices();
    const indonesianVoice = voices.find(v => v.lang && v.lang.includes("id"));
    if (indonesianVoice) utterance.voice = indonesianVoice;

    setTimeout(() => {
      window.speechSynthesis.speak(utterance);
    }, 850);
  }

  function playCallAudio(queueNumber, counterName) {
    playAirportChime();
    speakQueue(queueNumber, counterName);
  }

  // Auto-play jika ada query param ?called=X
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const calledNumber = urlParams.get('called');
    if (calledNumber) {
      setTimeout(() => {
        playCallAudio(calledNumber, "Loket Kasir 1");
      }, 300);
    }
  });
</script>

<%- include("../../layouts/footer") %>
