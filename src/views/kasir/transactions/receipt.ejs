<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Struk Transaksi #<%= tx.id %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-mono {
      font-family: 'Space Mono', monospace;
    }

    /* Print Styling Khusus Thermal 58mm & 80mm */
    @media print {
      @page {
        size: var(--paper-size, 58mm) auto;
        margin: 0;
      }
      html, body {
        width: var(--paper-size, 58mm) !important;
        max-width: var(--paper-size, 58mm) !important;
        min-width: var(--paper-size, 58mm) !important;
        margin: 0 auto !important;
        padding: 2mm 3mm !important;
        background: #ffffff !important;
        color: #000000 !important;
        font-size: 8.5pt !important;
        line-height: 1.25 !important;
      }
      .no-print {
        display: none !important;
      }
      .receipt-card {
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
      }
      .thermal-border {
        border-top: 1px dashed #000000 !important;
      }
      .thermal-double-border {
        border-top: 1px solid #000000 !important;
        border-bottom: 1px solid #000000 !important;
      }
      * {
        color: #000000 !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col items-center justify-center p-3 sm:p-4">

  <!-- Thermal Paper Size Switcher (Hidden in Print) -->
  <div class="no-print mb-3 flex items-center space-x-2 bg-white px-3 py-1.5 rounded-2xl shadow-sm border border-slate-200 text-xs font-bold">
    <span class="text-slate-500 text-[11px]"><i class="fas fa-receipt mr-1 text-indigo-600"></i> Ukuran Kertas:</span>
    <button type="button" onclick="setPaperSize('58mm')" id="btn58" class="px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-xs font-bold transition-all shadow-sm">58mm (Mini POS)</button>
    <button type="button" onclick="setPaperSize('80mm')" id="btn80" class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all">80mm (Besar)</button>
  </div>

  <!-- Receipt Card Container (Thermal printer style) -->
  <div id="receiptContainer" class="receipt-card bg-white max-w-[340px] w-full rounded-3xl p-5 shadow-xl border border-slate-200 text-slate-800 relative">
    
    <!-- Top Header -->
    <div class="text-center pb-3 border-b border-dashed border-slate-300">
      <div class="w-10 h-10 bg-slate-900 text-white rounded-2xl flex items-center justify-center mx-auto mb-1.5 text-lg shadow-md no-print">
        <i class="fas fa-wallet"></i>
      </div>
      <h2 class="text-sm font-black uppercase tracking-tight text-slate-900 leading-tight">TABUNGAN MASYARAKAT</h2>
      <p class="text-[10px] text-slate-500 font-medium">STRUK RESMI PENERIMAAN KAS</p>
      <p class="text-[9px] text-slate-400 font-mono"><%= new Date(tx.createdAt).toLocaleDateString("id-ID", { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
    </div>

    <!-- Transaction Status & Amount -->
    <div class="my-3 text-center">
      <span class="inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider <%= tx.type === 'DEPOSIT' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
        <%= tx.type === 'DEPOSIT' ? 'SETORAN KAS (+)' : 'PENARIKAN KAS (-)' %>
      </span>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-1 font-mono">
        Rp <%= Math.abs(tx.amount).toLocaleString("id-ID") %>
      </h3>
      <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider mt-0.5">
        *** TRANSAKSI SUKSES ***
      </p>
    </div>

    <!-- Receipt Details Table -->
    <div class="py-2.5 border-t border-b border-dashed border-slate-300 space-y-1.5 text-[11px]">
      <div class="flex justify-between">
        <span class="text-slate-500">No. Referensi:</span>
        <span class="font-mono font-bold text-slate-800">TRX-<%= String(tx.id).padStart(6, '0') %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-500">Petugas Loket:</span>
        <span class="font-bold text-slate-800"><%= tx.cashier ? `${tx.cashier.role === 'ADMIN' ? 'Admin' : 'Kasir'} ${tx.cashier.name}` : 'Admin/Sistem' %></span>
      </div>

      <div class="pt-1.5 border-t border-slate-100 flex justify-between">
        <span class="text-slate-500">Nama Anggota:</span>
        <span class="font-bold text-slate-900"><%= tx.member.name %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-500">No. Rekening:</span>
        <span class="font-mono font-bold text-slate-800">
          <%= tx.member.accountNumber || ('TBG-2026-' + String(tx.member.id).padStart(4, '0')) %>
        </span>
      </div>

      <% if (tx.description) { %>
      <div class="flex justify-between">
        <span class="text-slate-500">Catatan:</span>
        <span class="text-slate-700 font-medium truncate max-w-[150px]"><%= tx.description %></span>
      </div>
      <% } %>

      <div class="pt-1.5 border-t border-slate-200 flex justify-between items-center bg-slate-50 p-1.5 rounded-lg font-bold">
        <span class="text-slate-600 text-[10px]">TOTAL SALDO AKHIR:</span>
        <span class="font-mono text-emerald-800 text-xs">
          Rp <%= saldoSaatItu.toLocaleString("id-ID") %>
        </span>
      </div>
    </div>

    <!-- QR Code Verification on Receipt -->
    <div class="mt-3 flex flex-col items-center justify-center">
      <div id="receiptQr" class="p-1.5 bg-white border border-slate-200 rounded-lg"></div>
      <span class="text-[8px] text-slate-400 font-mono mt-1">Verifikasi Digital: TRX-<%= String(tx.id).padStart(6, '0') %></span>
    </div>

    <!-- Receipt Footer Note -->
    <div class="mt-2 text-center text-[10px] text-slate-400">
      <p>Simpan struk ini sebagai bukti sah.</p>
      <p class="text-[9px] font-semibold text-slate-600">Terima kasih atas kepercayaan Anda.</p>
    </div>

    <!-- Action Buttons (Hidden on Print) -->
    <div class="no-print mt-5 space-y-2">
      <button 
        type="button" 
        onclick="window.print()" 
        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2 shadow-lg shadow-slate-900/10 transition-all"
      >
        <i class="fas fa-print"></i>
        <span>Cetak Struk Sekarang</span>
      </button>

      <% 
        const waText = encodeURIComponent(
          `*BUKTI TRANSAKSI TABUNGAN*\n` +
          `No. Ref: TRX-${String(tx.id).padStart(6, '0')}\n` +
          `Jenis: ${tx.type === 'DEPOSIT' ? 'Setoran Tunai' : 'Penarikan Saldo'}\n` +
          `Nama: ${tx.member.name}\n` +
          `No. Rek: ${tx.member.accountNumber || '-'}\n` +
          `Nominal: Rp ${Math.abs(tx.amount).toLocaleString('id-ID')}\n` +
          `*Saldo Akhir: Rp ${saldoSaatItu.toLocaleString('id-ID')}*\n` +
          `Petugas: ${tx.cashier ? `${tx.cashier.role === 'ADMIN' ? 'Admin' : 'Kasir'} ${tx.cashier.name}` : 'Admin'}\n` +
          `Waktu: ${new Date(tx.createdAt).toLocaleString('id-ID')}\n\n` +
          `Terima kasih telah menabung.`
        );
        const waLink = tx.member.phone ? `https://wa.me/${tx.member.phone.replace(/[^0-9]/g, '')}?text=${waText}` : null;
      %>

      <% if (waLink) { %>
      <a 
        href="<%= waLink %>" 
        target="_blank"
        class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2 shadow-lg shadow-emerald-600/10 transition-all"
      >
        <i class="fab fa-whatsapp text-sm"></i>
        <span>Kirim Struk via WhatsApp</span>
      </a>
      <% } %>

      <a 
        href="/kasir/dashboard" 
        class="block text-center py-2 text-xs font-semibold text-slate-500 hover:text-slate-800"
      >
        Kembali ke Dashboard Kasir
      </a>
    </div>
  </div>

  <script>
    // Inisialisasi QR Code Verifikasi Struk
    new QRCode(document.getElementById("receiptQr"), {
      text: "TRX-<%= String(tx.id).padStart(6, '0') %>|<%= tx.member.accountNumber || tx.member.id %>|<%= tx.amount %>",
      width: 64,
      height: 64,
      colorDark : "#000000",
      colorLight : "#ffffff",
      correctLevel : QRCode.CorrectLevel.M
    });

    function setPaperSize(size) {
      document.documentElement.style.setProperty('--paper-size', size);
      const container = document.getElementById('receiptContainer');
      const btn58 = document.getElementById('btn58');
      const btn80 = document.getElementById('btn80');

      if (size === '58mm') {
        container.style.maxWidth = '300px';
        btn58.className = 'px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-xs font-bold transition-all shadow-sm';
        btn80.className = 'px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all';
      } else {
        container.style.maxWidth = '380px';
        btn80.className = 'px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-xs font-bold transition-all shadow-sm';
        btn58.className = 'px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all';
      }
    }
  </script>
</body>
</html>
