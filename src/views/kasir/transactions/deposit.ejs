<%- include("../../layouts/header", { title: "Setoran Tabungan" }) %>

<div class="space-y-6">
  <!-- Top Stat Banner -->
  <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-3xl p-5 text-white shadow-lg flex items-center justify-between">
    <div>
      <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-200">
        Kasir Loket Tabungan
      </span>
      <h2 class="text-xl sm:text-2xl font-black mt-0.5">Form Setor Tunai</h2>
      <p class="text-xs text-emerald-100 mt-0.5">Input simpanan uang anggota via Scan QR ID atau input no. rekening</p>
    </div>
    <div class="text-right hidden sm:block">
      <span class="text-[11px] text-emerald-200 uppercase font-semibold">Total Setoran Hari Ini</span>
      <h3 class="text-xl font-black">
        Rp <%= (todayDepositTotal || 0).toLocaleString("id-ID") %>
      </h3>
    </div>
  </div>

  <!-- Responsive 2-Column Grid on Desktop -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column: Deposit Form (7 cols on PC) -->
    <div class="lg:col-span-7 space-y-4">
      
      <% if (error) { %>
      <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center space-x-2.5">
        <i class="fas fa-exclamation-circle text-rose-500 text-sm shrink-0"></i>
        <span><%= error %></span>
      </div>
      <% } %>

      <% if (success && !lastTransaction) { %>
      <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center space-x-2.5">
        <i class="fas fa-check-circle text-emerald-500 text-base shrink-0"></i>
        <span><%= success %></span>
      </div>
      <% } %>

      <!-- State 1: Verification Input Box (Input No. Rekening atau Scan QR ID) -->
      <div id="verifyBox" class="bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-4">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold text-slate-800">1. Identifikasi Rekening Anggota</label>
          <button
            type="button"
            onclick="openScannerModal()"
            class="px-3.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 active:scale-95 text-emerald-800 border border-emerald-200 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition-all shadow-sm"
          >
            <i class="fas fa-qrcode text-xs text-emerald-600"></i>
            <span>Scan QR ID Kamera</span>
          </button>
        </div>

        <p class="text-xs text-slate-500">
          Masukkan No. Rekening, No. WhatsApp, atau gunakan Scanner Barcode USB / Kamera untuk memilih anggota:
        </p>

        <form onsubmit="handleVerifySubmit(event)" class="flex gap-2">
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="fas fa-id-card text-xs"></i>
            </span>
            <input
              type="text"
              id="manualQrInput"
              placeholder="Contoh: 8820-2026-0001 atau No. HP..."
              autocomplete="off"
              required
              class="modern-input w-full pl-10 pr-3 py-3 rounded-2xl text-xs text-slate-800 font-bold focus:outline-none"
            />
          </div>
          <button
            type="submit"
            id="btnVerify"
            class="px-5 py-3 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white rounded-2xl text-xs font-black shadow-md shadow-emerald-600/20 transition-all flex items-center space-x-1"
          >
            <i class="fas fa-search"></i>
            <span>Cari</span>
          </button>
        </form>
      </div>

      <!-- State 2: Active Deposit Form (Terbuka Setelah Anggota Diverifikasi) -->
      <div id="depositFormCard" class="hidden bg-white rounded-3xl p-6 card-shadow border border-emerald-200 space-y-4 animate-fade-in">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-bold text-emerald-800">2. Input Nominal Setoran Kas</span>
          </div>
          <button
            type="button"
            onclick="resetDepositDesk()"
            class="px-3 py-1 bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-500 rounded-xl text-[11px] font-bold transition-all flex items-center space-x-1"
          >
            <i class="fas fa-undo text-[10px]"></i>
            <span>Ganti Anggota</span>
          </button>
        </div>

        <form action="/kasir/setoran" method="post" class="space-y-4" id="depositForm" onsubmit="return validateDeposit()">
          <input type="hidden" name="memberId" id="memberIdInput" value="" />

          <!-- Nominal Input -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Nominal Setoran Tunai (Rp)</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-sm">Rp</span>
              <input
                type="number"
                name="amount"
                id="amountInput"
                min="1000"
                step="1000"
                required
                placeholder="0"
                class="modern-input w-full pl-12 pr-4 py-3 rounded-2xl text-slate-800 font-bold text-lg focus:outline-none"
              />
            </div>
          </div>

          <!-- Quick Amount Chips -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">Pecahan Uang Cepat</label>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" onclick="setAmount(50000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">50.000</button>
              <button type="button" onclick="setAmount(100000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">100.000</button>
              <button type="button" onclick="setAmount(200000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">200.000</button>
              <button type="button" onclick="setAmount(500000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">500.000</button>
              <button type="button" onclick="setAmount(1000000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">1.000.000</button>
              <button type="button" onclick="setAmount(2000000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">2.000.000</button>
            </div>
          </div>

          <!-- Description Input -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Catatan Setoran (Opsional)</label>
            <textarea
              name="description"
              rows="2"
              placeholder="Catatan setoran..."
              class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-3.5 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white text-xs font-extrabold shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center space-x-2"
          >
            <i class="fas fa-check"></i>
            <span>Proses & Simpan Setoran Kas</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Right Column: Member Profile Preview & Summary Info (5 cols on PC) -->
    <div class="lg:col-span-5 space-y-4">
      <!-- Member Preview Card (Terbuka Setelah Diverifikasi) -->
      <div id="memberPreviewCard" class="hidden bg-white rounded-3xl p-5 card-shadow border border-emerald-100 space-y-3">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-black text-base border border-emerald-100 shrink-0">
            <i class="fas fa-user-check"></i>
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-800" id="previewName">-</h4>
            <span class="font-mono text-[11px] font-bold text-emerald-700 px-2 py-0.5 rounded-md bg-emerald-50 border border-emerald-100 inline-block mt-0.5" id="previewAcc">-</span>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2 text-xs">
          <div class="flex justify-between text-slate-500">
            <span>Saldo Tabungan Saat Ini:</span>
            <span class="font-black text-slate-900 text-sm" id="previewSaldo">Rp 0</span>
          </div>
          <div class="flex justify-between text-slate-500 text-[11px]">
            <span>Nomor WhatsApp:</span>
            <span class="font-semibold text-slate-700" id="previewPhone">-</span>
          </div>
        </div>
      </div>

      <!-- Quick Tips Card -->
      <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100 text-xs text-slate-600 space-y-2.5">
        <h4 class="font-bold text-slate-800 flex items-center">
          <i class="fas fa-shield-alt text-emerald-600 mr-2"></i>
          Standar Pelayanan Setor Kas
        </h4>
        <ul class="list-disc pl-4 space-y-1.5 text-[11px] text-slate-500 leading-relaxed">
          <li><b>Scan / Input Nomor</b>: Dropdown publik ditiadakan untuk menjaga privasi rekening anggota.</li>
          <li><b>Verifikasi Fisik</b>: Pastikan nama yang tampil sesuai dengan penyetor.</li>
          <li><b>Struk Resmi & WhatsApp</b>: Struk thermal dan notifikasi WhatsApp saldo awal/akhir otomatis terkirim.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Modal Scanner Kamera QR Code -->
<div id="scannerModal" class="fixed inset-0 modal-backdrop hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-5 max-w-sm w-full shadow-2xl relative animate-fade-in text-center">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">
          <i class="fas fa-camera"></i>
        </div>
        <h3 class="text-sm font-bold text-slate-800">Scan QR ID Anggota</h3>
      </div>
      <button type="button" onclick="closeScannerModal()" class="text-slate-400 hover:text-slate-600 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center">
        <i class="fas fa-times text-xs"></i>
      </button>
    </div>

    <p class="text-[11px] text-slate-500 mb-3">Arahkan kamera ke QR ID Anggota di layar HP / Kartu</p>

    <!-- Scanner Viewport -->
    <div class="relative overflow-hidden rounded-2xl border-2 border-dashed border-emerald-300 bg-slate-950 aspect-square flex items-center justify-center">
      <div id="qr-reader" class="w-full h-full"></div>
    </div>

    <div id="scannerStatus" class="mt-3 text-[11px] font-semibold text-slate-600">
      Mengaktifkan kamera...
    </div>

    <button
      type="button"
      onclick="closeScannerModal()"
      class="mt-4 w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all"
    >
      Tutup Kamera
    </button>
  </div>
</div>

<!-- Modal Struk Otomatis Jika Berhasil -->
<% if (lastTransaction) { %>
<div id="receiptModal" class="fixed inset-0 modal-backdrop flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-6 max-w-sm w-full shadow-2xl relative animate-fade-in text-center">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-2 text-xl">
      <i class="fas fa-check-circle"></i>
    </div>
    <h3 class="text-base font-black text-slate-900">Setoran Berhasil Disimpan!</h3>
    <p class="text-xs text-slate-500 mb-3">Bukti transaksi telah dicatat ke dalam buku tabungan</p>

    <!-- Mini Receipt Summary with Saldo Awal & Akhir -->
    <div class="bg-slate-50 rounded-2xl p-3.5 text-xs text-left space-y-2 border border-slate-200">
      <div class="flex justify-between">
        <span class="text-slate-400">Anggota</span>
        <span class="font-bold text-slate-800"><%= lastTransaction.member.name %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Saldo Awal</span>
        <span class="font-mono text-slate-600">Rp <%= (lastTransaction.saldoAwal || 0).toLocaleString("id-ID") %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Setoran (+)</span>
        <span class="font-bold text-emerald-600">+ Rp <%= lastTransaction.amount.toLocaleString("id-ID") %></span>
      </div>
      <div class="flex justify-between pt-1.5 border-t border-slate-200">
        <span class="text-slate-700 font-bold">Saldo Akhir</span>
        <span class="font-black text-slate-900 text-sm">Rp <%= lastTransaction.saldoAkhir.toLocaleString("id-ID") %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 space-y-2">
      <a 
        href="/kasir/receipt/<%= lastTransaction.id %>" 
        target="_blank"
        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2"
      >
        <i class="fas fa-print"></i>
        <span>Cetak Struk Transaksi (Thermal)</span>
      </a>

      <% 
        const waText = encodeURIComponent(
          `*BUKTI SETORAN TABUNGAN*\n` +
          `No. Ref: TRX-${String(lastTransaction.id).padStart(6, '0')}\n` +
          `Nama: ${lastTransaction.member.name}\n` +
          `Saldo Awal: Rp ${(lastTransaction.saldoAwal || 0).toLocaleString('id-ID')}\n` +
          `Setoran (+): Rp ${lastTransaction.amount.toLocaleString('id-ID')}\n` +
          `*Saldo Akhir: Rp ${lastTransaction.saldoAkhir.toLocaleString('id-ID')}*\n` +
          `Kasir: ${lastTransaction.cashierName}\n\n` +
          `Terima kasih telah menabung.`
        );
        const waLink = lastTransaction.member.phone ? `https://wa.me/${lastTransaction.member.phone.replace(/[^0-9]/g, '')}?text=${waText}` : null;
      %>

      <% if (waLink) { %>
      <a 
        href="<%= waLink %>" 
        target="_blank"
        class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white rounded-2xl text-xs font-bold flex items-center justify-center space-x-2"
      >
        <i class="fab fa-whatsapp"></i>
        <span>Kirim Ulang via WhatsApp</span>
      </a>
      <% } %>

      <button 
        type="button" 
        onclick="document.getElementById('receiptModal').classList.add('hidden')"
        class="w-full py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-700"
      >
        Tutup & Transaksi Baru
      </button>
    </div>
  </div>
</div>
<% } %>

<script>
  let html5QrCode = null;

  function setAmount(val) {
    document.getElementById('amountInput').value = val;
  }

  function validateDeposit() {
    const memberId = document.getElementById('memberIdInput').value;
    if (!memberId) {
      alert("Harap verifikasi / scan nomor anggota terlebih dahulu!");
      return false;
    }
    const amount = parseInt(document.getElementById('amountInput').value || 0, 10);
    if (!amount || amount < 1000) {
      alert("Masukkan nominal setoran yang valid (minimal Rp 1.000)!");
      return false;
    }
    return true;
  }

  // Verifikasi Anggota via Backend API
  async function verifyMember(qrCode) {
    try {
      const res = await fetch('/kasir/api/verify-qr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ qrCode })
      });
      const data = await res.json();
      if (!data.success) {
        alert(data.message || "Anggota tidak ditemukan!");
        return false;
      }

      const m = data.member;
      document.getElementById('memberIdInput').value = m.id;
      document.getElementById('previewName').textContent = m.name;
      document.getElementById('previewAcc').textContent = m.accountNumber;
      document.getElementById('previewPhone').textContent = m.phone;
      document.getElementById('previewSaldo').textContent = "Rp " + m.saldo.toLocaleString('id-ID');

      // Tampilkan Form Setoran & Kartu Profil
      document.getElementById('depositFormCard').classList.remove('hidden');
      document.getElementById('memberPreviewCard').classList.remove('hidden');

      // Focus ke input nominal
      const amtInput = document.getElementById('amountInput');
      amtInput.focus();
      amtInput.scrollIntoView({ behavior: 'smooth', block: 'center' });

      return true;
    } catch (err) {
      alert("Gagal memverifikasi anggota: " + err.message);
      return false;
    }
  }

  function resetDepositDesk() {
    document.getElementById('memberIdInput').value = '';
    document.getElementById('amountInput').value = '';
    document.getElementById('depositFormCard').classList.add('hidden');
    document.getElementById('memberPreviewCard').classList.add('hidden');
    document.getElementById('manualQrInput').value = '';
    document.getElementById('manualQrInput').focus();
  }

  async function handleVerifySubmit(e) {
    e.preventDefault();
    const val = document.getElementById('manualQrInput').value.trim();
    if (!val) return;
    await verifyMember(val);
  }

  async function handleQrScanSuccess(decodedText) {
    closeScannerModal();
    document.getElementById('manualQrInput').value = decodedText;
    await verifyMember(decodedText);
  }

  function openScannerModal() {
    const modal = document.getElementById('scannerModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('scannerStatus').textContent = "Mengarahkan kamera...";

    if (!html5QrCode && window.Html5Qrcode) {
      html5QrCode = new Html5Qrcode("qr-reader");
    }

    if (html5QrCode) {
      html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 220, height: 220 } },
        (decodedText) => {
          handleQrScanSuccess(decodedText);
        },
        () => {}
      ).then(() => {
        document.getElementById('scannerStatus').textContent = "Kamera aktif. Arahkan ke QR Code anggota.";
      }).catch(err => {
        document.getElementById('scannerStatus').innerHTML = `<span class="text-rose-600">Gagal membuka kamera: ${err}</span>`;
      });
    }
  }

  function closeScannerModal() {
    if (html5QrCode && html5QrCode.isScanning) {
      html5QrCode.stop().then(() => {
        html5QrCode.clear();
      }).catch(() => {});
    }
    const modal = document.getElementById('scannerModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

<%- include("../../layouts/footer") %>
