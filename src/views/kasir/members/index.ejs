<%- include("../../layouts/header", { title: "Data Anggota" }) %>

<div class="space-y-4">
  <!-- Header & Add Button -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-sm font-bold text-slate-800">Daftar Anggota Tabungan</h2>
      <p class="text-[11px] text-slate-400"><%= members.length %> Anggota Terdaftar</p>
    </div>
    <a
      href="/kasir/anggota/new"
      class="inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all"
    >
      <i class="fas fa-user-plus text-[11px]"></i>
      <span>Tambah</span>
    </a>
  </div>

  <!-- Search Input -->
  <div class="relative">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
      <i class="fas fa-search text-xs"></i>
    </span>
    <input
      type="text"
      id="memberListSearch"
      placeholder="Cari nama, no. rekening, no. WA..."
      class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 bg-white card-shadow focus:outline-none"
    />
  </div>

  <!-- Member Card List -->
  <div class="space-y-2.5" id="memberCardsContainer">
    <% if (members.length === 0) { %>
    <div class="bg-white rounded-3xl p-8 card-shadow border border-slate-100 text-center">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-lg">
        <i class="fas fa-users"></i>
      </div>
      <p class="text-xs font-bold text-slate-700">Belum ada data anggota</p>
      <p class="text-[11px] text-slate-400 mt-0.5">Klik tombol "Tambah" di atas untuk mendaftarkan anggota baru.</p>
    </div>
    <% } %>

    <% members.forEach(m => { %>
    <div
      class="member-card bg-white rounded-3xl p-4 card-shadow border border-slate-100 hover:border-indigo-100 transition-all"
      data-search="<%= (m.name + ' ' + (m.accountNumber || '') + ' ' + (m.phone || '') + ' ' + m.email).toLowerCase() %>"
    >
      <div class="flex items-start justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-extrabold text-sm shrink-0 border border-indigo-100">
            <%= m.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-800"><%= m.name %></h4>
            <div class="flex items-center space-x-1.5 mt-0.5">
              <span class="font-mono text-[10px] font-bold text-indigo-600 px-1.5 py-0.2 rounded bg-indigo-50">
                <%= m.accountNumber || ('TBG-2026-' + String(m.id).padStart(4, '0')) %>
              </span>
            </div>
          </div>
        </div>

        <a
          href="/kasir/anggota/<%= m.id %>/edit"
          class="w-8 h-8 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-600 flex items-center justify-center text-xs active:scale-95 transition-all border border-slate-200"
          title="Edit Data"
        >
          <i class="fas fa-pen text-[11px]"></i>
        </a>
      </div>

      <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
        <div class="flex items-center space-x-1.5">
          <i class="fab fa-whatsapp text-emerald-500 text-xs"></i>
          <span><%= m.phone || '-' %></span>
        </div>
        <div class="flex items-center space-x-2">
          <a
            href="/kasir/setoran"
            class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-700 font-bold hover:bg-emerald-100 text-[10px]"
          >
            + Setor
          </a>
          <a
            href="/kasir/penarikan"
            class="px-2.5 py-1 rounded-xl bg-amber-50 text-amber-700 font-bold hover:bg-amber-100 text-[10px]"
          >
            - Tarik
          </a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<script>
  const searchInput = document.getElementById("memberListSearch");
  const memberCards = document.querySelectorAll(".member-card");

  searchInput.addEventListener("input", function () {
    const q = this.value.toLowerCase().trim();
    memberCards.forEach(card => {
      const text = card.getAttribute("data-search") || "";
      if (!q || text.includes(q)) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  });
</script>

<%- include("../../layouts/footer") %>
