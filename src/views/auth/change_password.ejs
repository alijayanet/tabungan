<%- include("../layouts/header", { title: "Keamanan Akun" }) %>

<div class="space-y-4">
  <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100">
    <div class="flex items-center space-x-3 mb-4">
      <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-sm">
        <i class="fas fa-shield-alt"></i>
      </div>
      <div>
        <h2 class="text-sm font-bold text-slate-800">Ubah Kata Sandi / PIN</h2>
        <p class="text-[11px] text-slate-400">Jaga keamanan akun tabungan Anda</p>
      </div>
    </div>

    <% if (error) { %>
    <div class="mb-4 p-3.5 bg-rose-50 border border-rose-200 rounded-2xl flex items-center space-x-2.5 text-xs text-rose-700">
      <i class="fas fa-exclamation-circle text-rose-500 text-sm shrink-0"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <% if (success) { %>
    <div class="mb-4 p-3.5 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center space-x-2.5 text-xs text-emerald-800">
      <i class="fas fa-check-circle text-emerald-500 text-base shrink-0"></i>
      <span><%= success %></span>
    </div>
    <% } %>

    <form action="/password" method="post" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Kata Sandi Saat Ini</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <i class="fas fa-lock text-xs"></i>
          </span>
          <input
            type="password"
            name="currentPassword"
            required
            placeholder="••••••••"
            class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Kata Sandi Baru</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <i class="fas fa-key text-xs"></i>
          </span>
          <input
            type="password"
            name="newPassword"
            required
            minlength="6"
            placeholder="Minimal 6 karakter"
            class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Konfirmasi Kata Sandi Baru</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <i class="fas fa-check-double text-xs"></i>
          </span>
          <input
            type="password"
            name="confirmPassword"
            required
            minlength="6"
            placeholder="Ulangi kata sandi baru"
            class="modern-input w-full pl-10 pr-4 py-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
          />
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3.5 px-4 rounded-2xl fintech-gradient hover:opacity-95 active:scale-98 text-white text-xs font-bold shadow-lg shadow-indigo-950/20 transition-all flex items-center justify-center space-x-2"
      >
        <i class="fas fa-save text-xs"></i>
        <span>Simpan Kata Sandi Baru</span>
      </button>
    </form>
  </div>
</div>

<%- include("../layouts/footer") %>
