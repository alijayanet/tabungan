<%- include("../layouts/header", { title: "Dompet Tabungan" }) %>

<div class="space-y-4">
  <!-- Virtual Debit Card -->
  <div class="card-virtual rounded-3xl p-5 text-white shadow-xl card-shadow-lg border border-slate-700/50">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-6 bg-amber-400/90 rounded-md shadow-inner flex items-center justify-center">
          <div class="w-5 h-4 border border-amber-600/40 rounded-sm"></div>
        </div>
        <span class="text-[11px] tracking-widest font-semibold uppercase text-slate-300">TABUNGAN DIGITAL</span>
      </div>
      <button 
        type="button" 
        onclick="openQrModal()"
        class="flex items-center space-x-1.5 bg-white/10 hover:bg-white/20 active:scale-95 px-3 py-1 rounded-full border border-white/15 backdrop-blur-md transition-all text-xs font-semibold text-slate-100"
      >
        <i class="fas fa-qrcode text-xs"></i>
        <span>QR ID</span>
      </button>
    </div>

    <!-- Balance Section -->
    <div class="mb-4">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium text-slate-400">Total Saldo Tabungan</p>
        <button type="button" onclick="toggleBalanceVisibility()" class="text-slate-400 hover:text-white p-1 transition-colors text-xs flex items-center space-x-1">
          <i id="eyeIcon" class="fas fa-eye"></i>
          <span id="eyeText" class="text-[10px]">Sembunyikan</span>
        </button>
      </div>
      <div class="flex items-baseline space-x-1 mt-1">
        <span class="text-sm font-semibold text-emerald-400">Rp</span>
        <h2 id="balanceDisplay" class="text-2xl font-extrabold tracking-tight text-white">
          <%= saldo.toLocaleString("id-ID") %>
        </h2>
      </div>

      <% if (pendingWithdraw > 0) { %>
      <div class="mt-2 flex items-center space-x-2 bg-amber-500/15 border border-amber-500/30 rounded-xl px-2.5 py-1 text-[11px] text-amber-300">
        <i class="fas fa-clock text-amber-400"></i>
        <span>Rp <%= pendingWithdraw.toLocaleString("id-ID") %> sedang diproses kasir</span>
      </div>
      <% } %>
    </div>

    <!-- Account Number & Member Name -->
    <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
      <div>
        <p class="text-[10px] text-slate-400 uppercase font-mono">No. Rekening</p>
        <div class="flex items-center space-x-2 mt-0.5">
          <span id="accNumber" class="font-mono font-bold text-slate-200 tracking-wider">
            <%= (user && user.accountNumber) ? user.accountNumber : ('TBG-2026-' + String(user.id).padStart(4, '0')) %>
          </span>
          <button type="button" onclick="copyAccountNumber()" title="Salin Nomor Rekening" class="text-slate-400 hover:text-white active:scale-90 transition-transform">
            <i class="far fa-copy text-xs"></i>
          </button>
        </div>
      </div>
      <div class="text-right">
        <p class="text-[10px] text-slate-400 uppercase">Pemilik Rekening</p>
        <p class="font-semibold text-slate-100 truncate max-w-[130px]"><%= user.name %></p>
      </div>
    </div>
  </div>

  <!-- Savings Goal / Target Menabung Widget -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs border border-indigo-100">
          <i class="fas fa-bullseye"></i>
        </div>
        <div>
          <h4 class="text-xs font-bold text-slate-800"><%= goalTitle || "Target / Impian Menabung" %></h4>
          <p class="text-[10px] text-slate-400">
            <% if (goalTarget > 0) { %>
              Target: Rp <%= goalTarget.toLocaleString("id-ID") %> (<%= goalProgress %>%)
            <% } else { %>
              Belum ada target impian yang diatur
            <% } %>
          </p>
        </div>
      </div>

      <button
        type="button"
        onclick="openGoalModal()"
        class="text-[11px] font-bold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-xl transition-all"
      >
        <%= goalTarget > 0 ? "Ubah Target" : "+ Pasang Target" %>
      </button>
    </div>

    <% if (goalTarget > 0) { %>
    <div>
      <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
        <div
          class="bg-gradient-to-r from-indigo-500 to-emerald-500 h-full rounded-full transition-all duration-500"
          style="width: <%= goalProgress %>%;"
        ></div>
      </div>
      <div class="flex justify-between items-center mt-1 text-[10px] text-slate-400">
        <span>Terkumpul: Rp <%= saldo.toLocaleString("id-ID") %></span>
        <span><%= saldo >= goalTarget ? "🎉 Target Tercapai!" : "Kurang: Rp " + Math.max(0, goalTarget - saldo).toLocaleString("id-ID") %></span>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Quick Action Grid (4 Actions) -->
  <div class="bg-white rounded-3xl p-4 card-shadow border border-slate-100">
    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Layanan Tabungan</p>
    <div class="grid grid-cols-5 gap-1.5 text-center">
      <a href="/anggota/antrean" class="flex flex-col items-center group">
        <div class="action-circle-btn bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 group-hover:scale-105 border border-indigo-100">
          <i class="fas fa-ticket-alt text-base"></i>
        </div>
        <span class="text-[9px] font-bold text-slate-700 mt-1.5">Antrean</span>
      </a>

      <a href="/anggota/penarikan" class="flex flex-col items-center group">
        <div class="action-circle-btn bg-amber-50 text-amber-600 group-hover:bg-amber-100 group-hover:scale-105 border border-amber-100">
          <i class="fas fa-hand-holding-usd text-base"></i>
        </div>
        <span class="text-[9px] font-bold text-slate-700 mt-1.5">Tarik Saldo</span>
      </a>

      <a href="/anggota/buku-tabungan" class="flex flex-col items-center group">
        <div class="action-circle-btn bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 group-hover:scale-105 border border-emerald-100">
          <i class="fas fa-book text-base"></i>
        </div>
        <span class="text-[9px] font-bold text-slate-700 mt-1.5">Buku Kas</span>
      </a>

      <button type="button" onclick="openQrModal()" class="flex flex-col items-center group">
        <div class="action-circle-btn bg-purple-50 text-purple-600 group-hover:bg-purple-100 group-hover:scale-105 border border-purple-100">
          <i class="fas fa-qrcode text-base"></i>
        </div>
        <span class="text-[9px] font-bold text-slate-700 mt-1.5">QR ID</span>
      </button>

      <a href="/password" class="flex flex-col items-center group">
        <div class="action-circle-btn bg-slate-50 text-slate-600 group-hover:bg-slate-100 group-hover:scale-105 border border-slate-200">
          <i class="fas fa-shield-alt text-base"></i>
        </div>
        <span class="text-[9px] font-bold text-slate-700 mt-1.5">PIN</span>
      </a>
    </div>
  </div>

  <!-- Cash Flow Summary -->
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-white p-3.5 rounded-2xl border border-slate-100 card-shadow">
      <div class="flex items-center space-x-2 text-emerald-600 mb-1">
        <div class="w-6 h-6 rounded-lg bg-emerald-50 flex items-center justify-center text-xs">
          <i class="fas fa-arrow-down"></i>
        </div>
        <span class="text-[11px] font-bold uppercase text-slate-400">Total Masuk</span>
      </div>
      <p class="text-sm font-bold text-slate-800">
        Rp <%= (typeof totalDeposit !== 'undefined' ? totalDeposit : 0).toLocaleString("id-ID") %>
      </p>
    </div>

    <div class="bg-white p-3.5 rounded-2xl border border-slate-100 card-shadow">
      <div class="flex items-center space-x-2 text-rose-500 mb-1">
        <div class="w-6 h-6 rounded-lg bg-rose-50 flex items-center justify-center text-xs">
          <i class="fas fa-arrow-up"></i>
        </div>
        <span class="text-[11px] font-bold uppercase text-slate-400">Total Keluar</span>
      </div>
      <p class="text-sm font-bold text-slate-800">
        Rp <%= (typeof totalWithdraw !== 'undefined' ? totalWithdraw : 0).toLocaleString("id-ID") %>
      </p>
    </div>
  </div>

  <!-- Transaction Activity Feed -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h3 class="text-sm font-bold text-slate-800">Riwayat Mutasi</h3>
        <p class="text-[10px] text-slate-400">Klik transaksi untuk melihat struk bukti</p>
      </div>
      <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"><%= transaksi.length %> Data</span>
    </div>

    <!-- Filter Tabs -->
    <div class="flex space-x-1.5 mb-3 bg-slate-100/80 p-1 rounded-xl text-xs font-semibold text-slate-600">
      <button type="button" onclick="filterTransactions('ALL')" id="filter-ALL" class="flex-1 py-1 rounded-lg bg-white shadow-sm text-slate-900 transition-all">Semua</button>
      <button type="button" onclick="filterTransactions('DEPOSIT')" id="filter-DEPOSIT" class="flex-1 py-1 rounded-lg hover:text-slate-900 transition-all">Setoran</button>
      <button type="button" onclick="filterTransactions('WITHDRAWAL')" id="filter-WITHDRAWAL" class="flex-1 py-1 rounded-lg hover:text-slate-900 transition-all">Penarikan</button>
    </div>

    <!-- Transaction List with Clickable e-Receipt -->
    <div id="transactionList" class="space-y-2.5">
      <% if (transaksi.length === 0) { %>
      <div class="py-8 text-center">
        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
          <i class="fas fa-receipt text-lg"></i>
        </div>
        <p class="text-xs font-semibold text-slate-500">Belum ada riwayat transaksi</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Kunjungi kasir untuk melakukan setoran pertama Anda</p>
      </div>
      <% } %>

      <% transaksi.forEach(t => { %>
      <a 
        href="/anggota/receipt/<%= t.id %>"
        class="tx-item flex items-center justify-between p-3 rounded-2xl border border-slate-100 hover:bg-slate-50 hover:border-slate-200 transition-all block group"
        data-type="<%= t.type %>"
      >
        <div class="flex items-center space-x-3 overflow-hidden">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 <%= t.type === 'DEPOSIT' ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-rose-50 text-rose-500 border border-rose-100' %> group-hover:scale-105 transition-transform">
            <i class="fas <%= t.type === 'DEPOSIT' ? 'fa-arrow-down' : 'fa-arrow-up' %> text-sm"></i>
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-slate-800 truncate group-hover:text-indigo-600 transition-colors">
              <%= t.type === "DEPOSIT" ? "Setoran Tabungan" : "Penarikan Saldo" %>
            </p>
            <div class="flex items-center space-x-1.5 mt-0.5 text-[11px] text-slate-400">
              <span><%= t.createdAt.toLocaleDateString("id-ID", { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
              <% if (t.status === 'PENDING') { %>
                <span class="inline-block px-1.5 py-0.2 rounded bg-amber-100 text-amber-700 font-bold text-[9px]">PENDING</span>
              <% } else if (t.status === 'REJECTED') { %>
                <span class="inline-block px-1.5 py-0.2 rounded bg-rose-100 text-rose-700 font-bold text-[9px]">DITOLAK</span>
              <% } %>
            </div>
          </div>
        </div>

        <div class="text-right shrink-0 flex items-center space-x-2">
          <div>
            <p class="text-xs font-black <%= t.type === 'DEPOSIT' ? 'text-emerald-600' : 'text-rose-600' %>">
              <%= t.type === "DEPOSIT" ? "+" : "-" %> Rp <%= Math.abs(t.amount).toLocaleString("id-ID") %>
            </p>
            <span class="text-[10px] text-slate-400"><%= t.status === 'COMPLETED' ? 'Struk >' : t.status %></span>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</div>

<!-- Modal Target Menabung (Savings Goal) -->
<div id="goalModal" class="fixed inset-0 modal-backdrop hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-6 max-w-sm w-full shadow-2xl relative animate-fade-in">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm font-bold">
          <i class="fas fa-bullseye"></i>
        </div>
        <h3 class="text-sm font-bold text-slate-800">Target Menabung</h3>
      </div>
      <button type="button" onclick="closeGoalModal()" class="text-slate-400 hover:text-slate-600 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center">
        <i class="fas fa-times text-xs"></i>
      </button>
    </div>

    <form action="/anggota/goal" method="post" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Nama Impian / Target</label>
        <input
          type="text"
          name="goalTitle"
          value="<%= goalTitle || '' %>"
          required
          placeholder="Contoh: Tabungan Qurban, Beli HP, dll"
          class="modern-input w-full px-3.5 py-2.5 rounded-xl text-xs text-slate-800 focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Target Nominal (Rp)</label>
        <input
          type="number"
          name="goalTarget"
          value="<%= goalTarget || '' %>"
          required
          min="10000"
          step="10000"
          placeholder="Contoh: 3000000"
          class="modern-input w-full px-3.5 py-2.5 rounded-xl text-xs text-slate-800 font-bold focus:outline-none"
        />
      </div>

      <button
        type="submit"
        class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 active:scale-98 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-indigo-600/20"
      >
        Simpan Target Impian
      </button>
    </form>
  </div>
</div>

<!-- Modal QR Code Member -->
<div id="qrModal" class="fixed inset-0 modal-backdrop hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-3xl p-6 max-w-xs w-full shadow-2xl text-center relative animate-fade-in">
    <button type="button" onclick="closeQrModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center">
      <i class="fas fa-times text-sm"></i>
    </button>

    <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 mx-auto mb-3">
      <i class="fas fa-qrcode text-xl"></i>
    </div>
    <h3 class="text-base font-bold text-slate-800">QR ID Anggota</h3>
    <p class="text-xs text-slate-500 mt-0.5">Tunjukkan QR ini ke kasir untuk proses setor/tarik cepat</p>

    <!-- QR Container -->
    <div class="my-4 p-4 bg-slate-50 rounded-2xl border border-slate-200 inline-block shadow-inner">
      <div id="qrcode" class="mx-auto flex justify-center"></div>
    </div>

    <div class="bg-slate-100 rounded-xl p-2.5 text-xs font-mono font-bold text-slate-700">
      <%= (user && user.accountNumber) ? user.accountNumber : ('TBG-2026-' + String(user.id).padStart(4, '0')) %>
    </div>
    <p class="text-[11px] text-slate-500 font-semibold mt-1"><%= user.name %></p>
  </div>
</div>

<!-- Toast notification for copy -->
<div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 bg-slate-900/90 text-white text-xs font-semibold px-4 py-2 rounded-full shadow-xl z-50 hidden transition-opacity">
  Nomor rekening disalin!
</div>

<script>
  let isBalanceHidden = false;
  const actualBalance = "<%= saldo.toLocaleString('id-ID') %>";

  function toggleBalanceVisibility() {
    isBalanceHidden = !isBalanceHidden;
    const balanceDisplay = document.getElementById('balanceDisplay');
    const eyeIcon = document.getElementById('eyeIcon');
    const eyeText = document.getElementById('eyeText');

    if (isBalanceHidden) {
      balanceDisplay.textContent = "••••••••";
      eyeIcon.className = "fas fa-eye-slash";
      eyeText.textContent = "Lihat";
    } else {
      balanceDisplay.textContent = actualBalance;
      eyeIcon.className = "fas fa-eye";
      eyeText.textContent = "Sembunyikan";
    }
  }

  function copyAccountNumber() {
    const accNumber = document.getElementById('accNumber').innerText.trim();
    navigator.clipboard.writeText(accNumber).then(() => {
      showToast("Nomor rekening disalin!");
    });
  }

  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 2000);
  }

  function filterTransactions(type) {
    ['ALL', 'DEPOSIT', 'WITHDRAWAL'].forEach(t => {
      const btn = document.getElementById('filter-' + t);
      if (t === type) {
        btn.classList.add('bg-white', 'shadow-sm', 'text-slate-900');
      } else {
        btn.classList.remove('bg-white', 'shadow-sm', 'text-slate-900');
      }
    });

    const items = document.querySelectorAll('.tx-item');
    items.forEach(item => {
      if (type === 'ALL' || item.dataset.type === type) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function openGoalModal() {
    const modal = document.getElementById('goalModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeGoalModal() {
    const modal = document.getElementById('goalModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  let qrGenerated = false;
  function openQrModal() {
    const modal = document.getElementById('qrModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');

    if (!qrGenerated) {
      const qrData = "<%= (user && user.accountNumber) ? user.accountNumber : ('TBG-2026-' + String(user.id).padStart(4, '0')) %>";
      new QRCode(document.getElementById("qrcode"), {
        text: qrData,
        width: 160,
        height: 160,
        colorDark : "#0f172a",
        colorLight : "#f8fafc",
        correctLevel : QRCode.CorrectLevel.H
      });
      qrGenerated = true;
    }
  }

  function closeQrModal() {
    const modal = document.getElementById('qrModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

<%- include("../layouts/footer") %>
