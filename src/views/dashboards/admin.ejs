<%- include("../layouts/header", { title: "Dashboard Admin" }) %>

<div class="space-y-6">
  <!-- Top Welcome & Quick Overview Banner -->
  <div class="card-virtual rounded-3xl p-6 text-white card-shadow-lg border border-slate-700/50 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-2 mb-1">
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-extrabold uppercase tracking-wider">
          Panel Administrator
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-white">Ringkasan Sistem Tabungan</h2>
      <p class="text-xs sm:text-sm text-slate-300 mt-1">Monitoring perputaran dana, kasir, dan anggota secara real-time</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
      <a href="/kasir/setoran" class="flex-1 md:flex-none px-3.5 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center space-x-1.5">
        <i class="fas fa-arrow-circle-down"></i>
        <span>Setor Tunai</span>
      </a>
      <a href="/kasir/penarikan" class="flex-1 md:flex-none px-3.5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 active:scale-95 text-white text-xs font-bold shadow-lg shadow-amber-500/30 transition-all flex items-center justify-center space-x-1.5">
        <i class="fas fa-arrow-circle-up"></i>
        <span>Tarik Tunai</span>
      </a>
      <a href="/admin/members/new" class="flex-1 md:flex-none px-3.5 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center space-x-1.5">
        <i class="fas fa-user-plus"></i>
        <span>+ Anggota</span>
      </a>
    </div>
  </div>

  <!-- Key Metrics / Stats Cards (Grid 2 on Mobile, 4 on Desktop) -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <!-- Stat 1: Total Anggota -->
    <div class="bg-white rounded-3xl p-4 sm:p-5 card-shadow border border-slate-100 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-base border border-indigo-100">
          <i class="fas fa-users"></i>
        </div>
        <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          Aktif
        </span>
      </div>
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Total Anggota</p>
        <h3 class="text-xl sm:text-2xl font-black text-slate-800 mt-0.5">
          <span class="counter" data-target="<%= totalMembers %>">0</span>
        </h3>
      </div>
    </div>

    <!-- Stat 2: Total Saldo Keseluruhan -->
    <div class="bg-white rounded-3xl p-4 sm:p-5 card-shadow border border-slate-100 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-base border border-emerald-100">
          <i class="fas fa-wallet"></i>
        </div>
        <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-100">
          Total Dana
        </span>
      </div>
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Saldo Seluruh Anggota</p>
        <h3 class="text-xl sm:text-2xl font-black text-slate-800 mt-0.5 truncate">
          Rp <span class="counter" data-target="<%= saldoTotal %>">0</span>
        </h3>
      </div>
    </div>

    <!-- Stat 3: Kelola Kasir Link Card -->
    <a href="/admin/cashiers" class="bg-white rounded-3xl p-4 sm:p-5 card-shadow border border-slate-100 hover:border-indigo-200 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between mb-2">
        <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-base border border-blue-100 group-hover:scale-105 transition-transform">
          <i class="fas fa-cash-register"></i>
        </div>
        <i class="fas fa-chevron-right text-slate-300 text-xs group-hover:translate-x-1 transition-transform"></i>
      </div>
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Manajemen Kasir</p>
        <h4 class="text-sm font-bold text-slate-800 mt-0.5">Kelola Petugas Kasir</h4>
      </div>
    </a>

    <!-- Stat 4: WhatsApp Notifikasi Status Card -->
    <a href="/admin/whatsapp" class="bg-white rounded-3xl p-4 sm:p-5 card-shadow border border-slate-100 hover:border-emerald-200 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between mb-2">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-base border border-emerald-100 group-hover:scale-105 transition-transform">
          <i class="fab fa-whatsapp"></i>
        </div>
        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          Bot Aktif
        </span>
      </div>
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Layanan Notifikasi</p>
        <h4 class="text-sm font-bold text-slate-800 mt-0.5">Status WhatsApp</h4>
      </div>
    </a>
  </div>

  <!-- Charts & Analytics Section (2 Columns on Desktop) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
    <!-- Chart 1: Tren Saldo -->
    <div class="bg-white rounded-3xl p-5 sm:p-6 card-shadow border border-slate-100">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm sm:text-base font-bold text-slate-800 flex items-center">
            <i class="fas fa-chart-line text-indigo-600 mr-2"></i>
            Pertumbuhan Saldo Tabungan
          </h3>
          <p class="text-[11px] text-slate-400">Akumulasi 6 bulan terakhir</p>
        </div>
      </div>
      <div class="h-60 sm:h-72">
        <canvas id="balanceChart"></canvas>
      </div>
    </div>

    <!-- Chart 2: Setoran vs Penarikan -->
    <div class="bg-white rounded-3xl p-5 sm:p-6 card-shadow border border-slate-100">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm sm:text-base font-bold text-slate-800 flex items-center">
            <i class="fas fa-exchange-alt text-emerald-600 mr-2"></i>
            Volume Setoran vs Penarikan
          </h3>
          <p class="text-[11px] text-slate-400">Komparasi arus dana masuk & keluar</p>
        </div>
      </div>
      <div class="h-60 sm:h-72">
        <canvas id="volumeChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Transactions Full Width Table / Card List -->
  <% const txs = (typeof recentTransactions !== 'undefined' && recentTransactions) ? recentTransactions : []; %>
  <div class="bg-white rounded-3xl p-5 sm:p-6 card-shadow border border-slate-100">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-sm sm:text-base font-bold text-slate-800 flex items-center">
          <i class="fas fa-history text-indigo-600 mr-2"></i>
          Aktivitas Transaksi Terbaru
        </h3>
        <p class="text-[11px] text-slate-400">5 transaksi terakhir yang diproses</p>
      </div>
    </div>

    <div class="space-y-2.5">
      <% if (txs.length === 0) { %>
      <div class="py-8 text-center text-slate-400 text-xs">
        Belum ada aktivitas transaksi
      </div>
      <% } %>

      <% txs.forEach(t => { %>
      <div class="flex items-center justify-between p-3 sm:p-4 rounded-2xl border border-slate-100 hover:bg-slate-50 transition-colors">
        <div class="flex items-center space-x-3 overflow-hidden">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 <%= t.type === 'DEPOSIT' ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-rose-50 text-rose-600 border border-rose-100' %>">
            <i class="fas <%= t.type === 'DEPOSIT' ? 'fa-arrow-down' : 'fa-arrow-up' %> text-sm"></i>
          </div>
          <div class="overflow-hidden">
            <p class="text-xs sm:text-sm font-bold text-slate-800 truncate">
              <%= t.type === "DEPOSIT" ? "Setoran Tabungan" : "Penarikan Tunai" %>
              <span class="font-semibold text-slate-500">• <%= t.member ? t.member.name : '-' %></span>
            </p>
            <p class="text-[11px] text-slate-400">
              <%= new Date(t.createdAt).toLocaleString("id-ID") %> 
              <% if (t.cashier) { %> • Kasir: <%= t.cashier.name %><% } %>
            </p>
          </div>
        </div>

        <div class="text-right shrink-0">
          <p class="text-xs sm:text-sm font-black <%= t.type === 'DEPOSIT' ? 'text-emerald-600' : 'text-rose-600' %>">
            <%= t.type === "DEPOSIT" ? "+" : "-" %> Rp <%= Math.abs(t.amount).toLocaleString("id-ID") %>
          </p>
          <span class="text-[10px] text-slate-400 uppercase font-semibold"><%= t.status %></span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<script id="labels-data" type="application/json"><%- JSON.stringify((locals && locals.monthLabels) ? locals.monthLabels : []) %></script>
<script id="deposito-data" type="application/json"><%- JSON.stringify((locals && locals.depositSeries) ? locals.depositSeries : []) %></script>
<script id="penarikan-data" type="application/json"><%- JSON.stringify((locals && locals.withdrawSeries) ? locals.withdrawSeries : []) %></script>
<script id="saldo-data" type="application/json"><%- JSON.stringify((locals && locals.saldoSeries) ? locals.saldoSeries : []) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  function animateCounter() {
    const counters = document.querySelectorAll('.counter');
    counters.forEach(counter => {
      const target = parseInt(counter.getAttribute('data-target') || '0', 10);
      if (isNaN(target)) return;
      const increment = Math.max(1, Math.floor(target / 50));
      let current = 0;
      const updateCounter = () => {
        if (current < target) {
          current += increment;
          if (current > target) current = target;
          counter.textContent = current.toLocaleString('id-ID');
          setTimeout(updateCounter, 20);
        } else {
          counter.textContent = target.toLocaleString('id-ID');
        }
      };
      updateCounter();
    });
  }

  function initCharts() {
    const labels = JSON.parse(document.getElementById('labels-data')?.textContent || '[]');
    const deposito = JSON.parse(document.getElementById('deposito-data')?.textContent || '[]');
    const penarikan = JSON.parse(document.getElementById('penarikan-data')?.textContent || '[]');
    const saldo = JSON.parse(document.getElementById('saldo-data')?.textContent || '[]');

    const balanceCtx = document.getElementById('balanceChart');
    if (balanceCtx && window.Chart) {
      new Chart(balanceCtx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Saldo Total',
              data: saldo,
              borderColor: '#4f46e5',
              backgroundColor: 'rgba(79, 70, 229, 0.08)',
              tension: 0.4,
              fill: true,
              borderWidth: 3,
              pointRadius: 4,
              pointBackgroundColor: '#4f46e5'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              ticks: {
                callback: function(value) {
                  return 'Rp ' + (value >= 1000000 ? (value / 1000000).toFixed(1) + ' jt' : value.toLocaleString('id-ID'));
                },
                font: { size: 11 }
              },
              grid: { color: 'rgba(241, 245, 249, 1)' }
            },
            x: {
              ticks: { font: { size: 11 } },
              grid: { display: false }
            }
          }
        }
      });
    }

    const volumeCtx = document.getElementById('volumeChart');
    if (volumeCtx && window.Chart) {
      new Chart(volumeCtx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Setoran',
              data: deposito,
              backgroundColor: 'rgba(16, 185, 129, 0.85)',
              borderRadius: 8,
              maxBarThickness: 28
            },
            {
              label: 'Penarikan',
              data: penarikan,
              backgroundColor: 'rgba(244, 63, 94, 0.85)',
              borderRadius: 8,
              maxBarThickness: 28
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: { font: { size: 11, weight: 'bold' } }
            }
          },
          scales: {
            y: {
              ticks: {
                callback: function(value) {
                  return 'Rp ' + (value >= 1000000 ? (value / 1000000).toFixed(1) + ' jt' : value.toLocaleString('id-ID'));
                },
                font: { size: 11 }
              },
              grid: { color: 'rgba(241, 245, 249, 1)' }
            },
            x: {
              ticks: { font: { size: 11 } },
              grid: { display: false }
            }
          }
        }
      });
    }
  }

  window.addEventListener('load', function() {
    animateCounter();
    initCharts();
  });
</script>

<%- include("../layouts/footer") %>
