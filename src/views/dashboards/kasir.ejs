<%- include("../layouts/header", { title: "Dashboard Kasir" }) %>

<div class="space-y-6">
  <!-- Today's Cash Flow Summary Banner (Responsive 3 Cards on Desktop) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Card 1: Net Kas Hari Ini -->
    <% const netCash = (todayDepositTotal || 0) - (todayWithdrawTotal || 0); %>
    <div class="card-virtual rounded-3xl p-5 text-white card-shadow-lg border border-slate-700/50 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-300">
          Kas Bersih Kasir Hari Ini
        </span>
        <span class="text-[9px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-bold">
          Live
        </span>
      </div>
      <div>
        <p class="text-xs text-slate-400">Net Arus Kas</p>
        <h3 class="text-2xl font-black text-white mt-0.5">
          Rp <%= netCash.toLocaleString("id-ID") %>
        </h3>
      </div>
    </div>

    <!-- Card 2: Total Setoran Masuk -->
    <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-600">
          Setoran Masuk Hari Ini
        </span>
        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
          <i class="fas fa-arrow-down"></i>
        </div>
      </div>
      <div>
        <p class="text-xs text-slate-400">Total Uang Masuk</p>
        <h3 class="text-2xl font-black text-emerald-600 mt-0.5">
          Rp <%= (todayDepositTotal || 0).toLocaleString("id-ID") %>
        </h3>
      </div>
    </div>

    <!-- Card 3: Total Penarikan Keluar -->
    <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-rose-600">
          Penarikan Keluar Hari Ini
        </span>
        <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xs">
          <i class="fas fa-arrow-up"></i>
        </div>
      </div>
      <div>
        <p class="text-xs text-slate-400">Total Uang Keluar</p>
        <h3 class="text-2xl font-black text-rose-600 mt-0.5">
          Rp <%= (todayWithdrawTotal || 0).toLocaleString("id-ID") %>
        </h3>
      </div>
    </div>
  </div>

  <!-- Pending Alert Banner (if any) -->
  <% if (typeof pendingRequestsCount !== 'undefined' && pendingRequestsCount > 0) { %>
  <a href="/kasir/penarikan/requests" class="block bg-amber-500 hover:bg-amber-600 active:scale-98 rounded-3xl p-4 text-white shadow-lg shadow-amber-500/20 transition-all">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center font-bold text-lg">
          <i class="fas fa-bell animate-bounce"></i>
        </div>
        <div>
          <h4 class="text-sm font-bold"><%= pendingRequestsCount %> Permintaan Penarikan Saldo Baru</h4>
          <p class="text-xs text-amber-100">Anggota sedang menunggu konfirmasi pencairan dana dari kasir</p>
        </div>
      </div>
      <span class="text-xs font-bold px-3 py-1.5 bg-white/20 rounded-xl hover:bg-white/30 transition-all">
        Buka Antrean <i class="fas fa-chevron-right text-[10px] ml-1"></i>
      </span>
    </div>
  </a>
  <% } %>

  <!-- Desktop 2-Column Layout: Left Action Pad, Right Live Transaction Feed -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column: Quick Actions & Shortcut (5 Columns on Desktop) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-4 flex items-center">
          <i class="fas fa-bolt text-amber-500 mr-2"></i>
          Pelayanan Cepat Kasir
        </h3>

        <div class="grid grid-cols-2 gap-3">
          <a href="/kasir/setoran" class="p-4 rounded-2xl bg-emerald-50/80 hover:bg-emerald-100/80 border border-emerald-200/80 transition-all group flex flex-col items-center text-center">
            <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl shadow-md shadow-emerald-600/20 group-hover:scale-105 transition-transform mb-2">
              <i class="fas fa-arrow-circle-down"></i>
            </div>
            <span class="text-xs font-bold text-emerald-950">Setoran Tabungan</span>
            <span class="text-[10px] text-emerald-700 mt-0.5">Input simpanan uang</span>
          </a>

          <a href="/kasir/penarikan" class="p-4 rounded-2xl bg-amber-50/80 hover:bg-amber-100/80 border border-amber-200/80 transition-all group flex flex-col items-center text-center">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform mb-2">
              <i class="fas fa-hand-holding-usd"></i>
            </div>
            <span class="text-xs font-bold text-amber-950">Tarik Saldo</span>
            <span class="text-[10px] text-amber-700 mt-0.5">Pencairan tunai anggota</span>
          </a>

          <a href="/kasir/penarikan/requests" class="p-4 rounded-2xl bg-indigo-50/80 hover:bg-indigo-100/80 border border-indigo-200/80 transition-all group flex flex-col items-center text-center relative">
            <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-xl shadow-md shadow-indigo-600/20 group-hover:scale-105 transition-transform mb-2">
              <i class="fas fa-tasks"></i>
            </div>
            <% if (typeof pendingRequestsCount !== 'undefined' && pendingRequestsCount > 0) { %>
            <span class="absolute top-3 right-3 px-2 py-0.5 bg-rose-500 text-white rounded-full text-[10px] font-black">
              <%= pendingRequestsCount %>
            </span>
            <% } %>
            <span class="text-xs font-bold text-indigo-950">Antrean Penarikan</span>
            <span class="text-[10px] text-indigo-700 mt-0.5">Verifikasi pengajuan</span>
          </a>

          <a href="/kasir/anggota" class="p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-all group flex flex-col items-center text-center">
            <div class="w-12 h-12 rounded-2xl bg-slate-800 text-white flex items-center justify-center text-xl shadow-md group-hover:scale-105 transition-transform mb-2">
              <i class="fas fa-users"></i>
            </div>
            <span class="text-xs font-bold text-slate-900">Kelola Anggota</span>
            <span class="text-[10px] text-slate-500 mt-0.5">Pendaftaran & edit</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Today's Live Transaction Feed (7 Columns on Desktop) -->
    <div class="lg:col-span-7">
      <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-slate-800 flex items-center">
              <i class="fas fa-receipt text-emerald-600 mr-2"></i>
              Aktivitas Transaksi Hari Ini
            </h3>
            <p class="text-[11px] text-slate-400">Total <%= transaksiHarian.length %> transaksi selesai</p>
          </div>
        </div>

        <div class="space-y-2.5 max-h-[500px] overflow-y-auto pr-1">
          <% if (transaksiHarian.length === 0) { %>
          <div class="py-12 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-lg">
              <i class="fas fa-clipboard-check"></i>
            </div>
            <p class="text-xs font-bold text-slate-700">Belum ada transaksi hari ini</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Gunakan tombol Setor atau Tarik di samping untuk melayani anggota.</p>
          </div>
          <% } %>

          <% transaksiHarian.forEach(t => { %>
          <div class="flex items-center justify-between p-3.5 rounded-2xl border border-slate-100 hover:bg-slate-50 transition-colors">
            <div class="flex items-center space-x-3 overflow-hidden">
              <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 <%= t.type === 'DEPOSIT' ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-rose-50 text-rose-600 border border-rose-100' %>">
                <i class="fas <%= t.type === 'DEPOSIT' ? 'fa-arrow-down' : 'fa-arrow-up' %> text-sm"></i>
              </div>
              <div class="overflow-hidden">
                <p class="text-xs sm:text-sm font-bold text-slate-800 truncate"><%= t.member.name %></p>
                <p class="text-[11px] text-slate-400">
                  <%= new Date(t.createdAt).toLocaleTimeString("id-ID", { hour: '2-digit', minute: '2-digit' }) %> • 
                  <span class="font-mono"><%= t.member.accountNumber || ('TBG-2026-' + String(t.member.id).padStart(4, '0')) %></span>
                </p>
              </div>
            </div>

            <div class="text-right shrink-0 flex items-center space-x-3">
              <div>
                <p class="text-xs sm:text-sm font-black <%= t.type === 'DEPOSIT' ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= t.type === "DEPOSIT" ? "+" : "-" %> Rp <%= Math.abs(t.amount).toLocaleString("id-ID") %>
                </p>
                <span class="text-[10px] text-slate-400 uppercase font-semibold"><%= t.type === "DEPOSIT" ? "Setoran" : "Penarikan" %></span>
              </div>
              <a 
                href="/kasir/receipt/<%= t.id %>" 
                title="Cetak Struk Transaksi"
                class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 flex items-center justify-center text-xs transition-all border border-slate-200"
              >
                <i class="fas fa-print"></i>
              </a>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../layouts/footer") %>
