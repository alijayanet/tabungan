<%- include("../layouts/header", { title: "Tarik Saldo Tabungan" }) %>

<div class="space-y-4">
  <!-- Saldo Summary Card -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Saldo Tersedia</span>
      <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-bold border border-emerald-100">
        Siap Ditarik
      </span>
    </div>
    <div class="flex items-baseline space-x-1">
      <span class="text-sm font-bold text-slate-400">Rp</span>
      <h2 class="text-2xl font-extrabold text-slate-900" id="saldoTersediaVal">
        <%= (typeof saldoTersedia !== 'undefined' ? saldoTersedia : saldo).toLocaleString("id-ID") %>
      </h2>
    </div>

    <% if (typeof pendingWithdraw !== 'undefined' && pendingWithdraw > 0) { %>
    <div class="mt-3 p-2.5 bg-amber-50 rounded-xl border border-amber-200/60 flex items-center space-x-2 text-xs text-amber-800">
      <i class="fas fa-info-circle text-amber-500 shrink-0"></i>
      <span>Rp <%= pendingWithdraw.toLocaleString("id-ID") %> sedang dalam pengajuan persetujuan sebelumnya.</span>
    </div>
    <% } %>
  </div>

  <!-- Form Tarik Saldo -->
  <div class="bg-white rounded-3xl p-5 card-shadow border border-slate-100">
    <div class="flex items-center space-x-2 mb-4">
      <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm font-bold">
        <i class="fas fa-money-bill-wave"></i>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-800">Pengajuan Penarikan Tunai</h3>
        <p class="text-[11px] text-slate-400">Persetujuan akan diproses langsung oleh kasir</p>
      </div>
    </div>

    <% if (error) { %>
    <div class="mb-4 p-3 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center space-x-2.5">
      <i class="fas fa-exclamation-circle text-rose-500 text-sm shrink-0"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <% if (success) { %>
    <div class="mb-4 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-start space-x-2.5">
      <i class="fas fa-check-circle text-emerald-500 text-base shrink-0 mt-0.5"></i>
      <div>
        <p class="font-bold text-emerald-900">Pengajuan Berhasil Dikirim!</p>
        <p class="text-[11px] text-emerald-700 mt-0.5"><%= success %></p>
      </div>
    </div>
    <% } %>

    <form action="/anggota/penarikan" method="post" class="space-y-4" onsubmit="return validateWithdrawForm()">
      <!-- Nominal Input -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Nominal Penarikan (Rp)</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-sm">Rp</span>
          <input
            type="number"
            name="amount"
            id="amountInput"
            min="10000"
            step="1000"
            max="<%= (typeof saldoTersedia !== 'undefined' ? saldoTersedia : saldo) %>"
            placeholder="0"
            required
            oninput="calculateRemaining()"
            class="modern-input w-full pl-12 pr-4 py-3 rounded-2xl text-slate-800 font-bold text-base focus:outline-none"
          />
        </div>
      </div>

      <!-- Quick Amount Chips -->
      <div>
        <label class="block text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">Pilih Nominal Cepat</label>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="setNominal(50000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">
            50.000
          </button>
          <button type="button" onclick="setNominal(100000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">
            100.000
          </button>
          <button type="button" onclick="setNominal(200000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">
            200.000
          </button>
          <button type="button" onclick="setNominal(500000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">
            500.000
          </button>
          <button type="button" onclick="setNominal(1000000)" class="py-2 px-1 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 active:scale-95 transition-all">
            1.000.000
          </button>
          <button type="button" onclick="setNominalMax()" class="py-2 px-1 rounded-xl bg-amber-50 border border-amber-200 text-xs font-extrabold text-amber-700 hover:bg-amber-100 active:scale-95 transition-all">
            Tarik Semua
          </button>
        </div>
      </div>

      <!-- Live Calculation Box -->
      <div id="calcBox" class="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 text-xs space-y-1.5">
        <div class="flex justify-between text-slate-500">
          <span>Estimasi sisa saldo setelah ditarik:</span>
          <span id="remainingBalance" class="font-bold text-slate-800">
            Rp <%= (typeof saldoTersedia !== 'undefined' ? saldoTersedia : saldo).toLocaleString("id-ID") %>
          </span>
        </div>
      </div>

      <!-- Keterangan Input -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Keperluan Penarikan (Opsional)</label>
        <textarea
          name="description"
          rows="2"
          placeholder="Contoh: Kebutuhan belanja / bayar sekolah..."
          class="modern-input w-full p-3 rounded-2xl text-xs text-slate-800 focus:outline-none"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full py-3.5 px-4 rounded-2xl bg-amber-500 hover:bg-amber-600 active:scale-98 text-white text-xs font-extrabold shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center space-x-2"
      >
        <i class="fas fa-paper-plane"></i>
        <span>Kirim Permintaan Penarikan</span>
      </button>

      <a href="/anggota/dashboard" class="block text-center text-xs font-semibold text-slate-500 hover:text-slate-700 py-1">
        Kembali ke Dompet
      </a>
    </form>
  </div>
</div>

<script>
  const maxAvailable = <%= (typeof saldoTersedia !== 'undefined' ? saldoTersedia : saldo) %>;

  function setNominal(amount) {
    if (amount > maxAvailable) {
      alert("Nominal melebihi saldo tersedia Anda!");
      return;
    }
    const input = document.getElementById('amountInput');
    input.value = amount;
    calculateRemaining();
  }

  function setNominalMax() {
    const input = document.getElementById('amountInput');
    input.value = maxAvailable;
    calculateRemaining();
  }

  function calculateRemaining() {
    const input = document.getElementById('amountInput');
    const nominal = parseInt(input.value || 0, 10);
    const remainingSpan = document.getElementById('remainingBalance');
    
    const remaining = maxAvailable - nominal;
    if (remaining < 0) {
      remainingSpan.textContent = "Saldo Tidak Cukup!";
      remainingSpan.className = "font-bold text-rose-600";
    } else {
      remainingSpan.textContent = "Rp " + remaining.toLocaleString("id-ID");
      remainingSpan.className = "font-bold text-slate-800";
    }
  }

  function validateWithdrawForm() {
    const input = document.getElementById('amountInput');
    const nominal = parseInt(input.value || 0, 10);
    if (!nominal || nominal <= 0) {
      alert("Masukkan nominal penarikan yang valid!");
      return false;
    }
    if (nominal > maxAvailable) {
      alert("Nominal penarikan melebihi saldo tersedia Anda!");
      return false;
    }
    return true;
  }
</script>

<%- include("../layouts/footer") %>
