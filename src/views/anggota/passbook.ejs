<%- include("../layouts/header", { title: "Buku Tabungan Digital" }) %>

<style>
  @media print {
    @page {
      size: portrait;
      margin: 10mm 12mm 10mm 12mm;
    }
    html, body {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 10pt !important;
    }
    /* Sembunyikan semua elemen navigasi aplikasi */
    header, footer, nav, .no-print, #loadingOverlay {
      display: none !important;
    }
    /* Buka lebar seluruh kontainer pembungkus Tailwind */
    div, main, .max-w-md, .sm\:max-w-lg, .max-w-6xl, .max-w-3xl, .max-w-2xl, .print-container, .print-card {
      max-width: 100% !important;
      width: 100% !important;
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }
    .overflow-x-auto {
      overflow: visible !important;
      display: block !important;
      width: 100% !important;
    }
    .print-header {
      display: block !important;
      margin-bottom: 15px !important;
      border-bottom: 2px solid #000000 !important;
      padding-bottom: 8px !important;
      text-align: center !important;
    }
    .print-info-box {
      border: 1px solid #000000 !important;
      background: #fafafa !important;
      padding: 8px 12px !important;
      margin-bottom: 15px !important;
      border-radius: 4px !important;
      display: grid !important;
      grid-template-columns: 1fr 1fr 1fr !important;
    }
    /* Table format penuh kertas print */
    table {
      width: 100% !important;
      max-width: 100% !important;
      border-collapse: collapse !important;
      margin-top: 5px !important;
    }
    th, td {
      border: 1px solid #000000 !important;
      padding: 6px 6px !important;
      font-size: 9pt !important;
      color: #000000 !important;
    }
    th {
      background-color: #f1f5f9 !important;
      font-weight: bold !important;
      text-align: center !important;
    }
    .no-print-col {
      display: none !important;
    }
    .print-footer-status {
      display: flex !important;
      justify-content: space-between !important;
      margin-top: 15px !important;
      font-size: 8pt !important;
      color: #475569 !important;
    }
  }
</style>

<div class="print-container space-y-4 max-w-3xl mx-auto">
  <!-- Top Action & Info Bar (Hidden in Print) -->
  <div class="no-print bg-white rounded-3xl p-5 card-shadow border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h2 class="text-base sm:text-lg font-bold text-slate-800">Buku Tabungan Digital</h2>
      <p class="text-xs text-slate-400">Rekapitulasi mutasi debit, kredit, dan saldo berjalan</p>
    </div>
    <div class="flex items-center space-x-2">
      <button
        type="button"
        onclick="window.print()"
        class="px-4 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all flex items-center space-x-2"
      >
        <i class="fas fa-print"></i>
        <span>Cetak Buku Tabungan</span>
      </button>
    </div>
  </div>

  <!-- Kop Surat Khusus Print (Hanya Muncul saat Cetak / PDF) -->
  <div class="hidden print-header">
    <h1 class="text-xl font-black uppercase tracking-wider text-black leading-tight"><%= appName %></h1>
    <p class="text-xs font-bold text-slate-700 uppercase tracking-wide">Buku Mutasi Rekening Tabungan</p>
    <p class="text-[10px] text-slate-500 font-mono mt-0.5">Dicetak pada: <%= new Date().toLocaleString("id-ID") %></p>
  </div>

  <!-- Buku Tabungan Card Style -->
  <div class="print-card bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-4">
    <!-- Header Rekening Anggota -->
    <div class="print-info-box p-4 rounded-2xl bg-slate-50 border border-slate-200 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
      <div>
        <span class="text-[10px] text-slate-500 font-semibold uppercase">Nama Anggota</span>
        <p class="font-bold text-slate-900 mt-0.5 text-sm"><%= user.name %></p>
      </div>
      <div>
        <span class="text-[10px] text-slate-500 font-semibold uppercase">No. Rekening</span>
        <p class="font-mono font-bold text-indigo-700 mt-0.5 text-sm"><%= user.accountNumber || '-' %></p>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <span class="text-[10px] text-slate-500 font-semibold uppercase">Total Saldo Terakhir</span>
        <p class="font-black text-emerald-700 text-sm mt-0.5">Rp <%= totalBalance.toLocaleString("id-ID") %></p>
      </div>
    </div>

    <!-- Mutasi Table -->
    <% if (mutasiList.length === 0) { %>
    <div class="py-12 text-center text-xs text-slate-400">
      Belum ada riwayat mutasi transaksi di buku tabungan Anda.
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500 font-bold uppercase text-[10px]">
            <th class="pb-2.5 pr-2 w-10 text-center">No</th>
            <th class="pb-2.5 pr-2 w-24">Tanggal</th>
            <th class="pb-2.5 pr-2">Keterangan Transaksi</th>
            <th class="pb-2.5 pr-2 text-right w-28">Debet (+)</th>
            <th class="pb-2.5 pr-2 text-right w-28">Kredit (-)</th>
            <th class="pb-2.5 pr-2 text-right w-32">Saldo Akhir</th>
            <th class="no-print no-print-col pb-2.5 text-center w-16">Struk</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-mono">
          <% mutasiList.forEach((m, idx) => { %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="py-2.5 pr-2 text-slate-400 text-[11px] text-center"><%= idx + 1 %></td>
            <td class="py-2.5 pr-2 text-slate-600 text-[11px] whitespace-nowrap">
              <%= new Date(m.date).toLocaleDateString("id-ID", { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
            </td>
            <td class="py-2.5 pr-2 font-sans font-medium text-slate-800 text-[11px]">
              <%= m.type === "DEPOSIT" ? "Setoran Kas" : "Penarikan Kas" %>
              <% if (m.description && m.description !== '-' && m.description !== 'Setoran via WhatsApp' && m.description !== 'Penarikan via WhatsApp') { %>
                <span class="text-slate-500 font-normal"> - <%= m.description %></span>
              <% } %>
            </td>
            <td class="py-2.5 pr-2 text-right text-emerald-700 font-bold text-[11px] whitespace-nowrap">
              <%= m.debit > 0 ? ("Rp " + m.debit.toLocaleString("id-ID")) : '-' %>
            </td>
            <td class="py-2.5 pr-2 text-right text-rose-700 font-bold text-[11px] whitespace-nowrap">
              <%= m.kredit > 0 ? ("Rp " + m.kredit.toLocaleString("id-ID")) : '-' %>
            </td>
            <td class="py-2.5 pr-2 text-right text-slate-900 font-black text-[11px] whitespace-nowrap">
              Rp <%= m.balance.toLocaleString("id-ID") %>
            </td>
            <td class="no-print no-print-col py-2.5 text-center font-sans">
              <a
                href="/anggota/receipt/<%= m.id %>"
                title="Lihat Struk"
                class="w-6 h-6 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 inline-flex items-center justify-center text-[10px] transition-all"
              >
                <i class="fas fa-receipt"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- Catatan Cetak Resmi -->
    <div class="print-footer-status pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
      <span>Total Mutasi: <b><%= mutasiList.length %> Transaksi</b></span>
      <span class="font-mono">Dokumen Buku Tabungan Sah & Terverifikasi Sistem</span>
    </div>
  </div>
</div>

<%- include("../layouts/footer") %>
