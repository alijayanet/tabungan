<%- include("../layouts/header", { title: "Struk Digital #" + tx.id }) %>

<style>
  @media print {
    @page {
      size: var(--paper-size, 58mm) auto;
      margin: 0;
    }
    header, footer, nav, .no-print, #loadingOverlay {
      display: none !important;
    }
    html, body {
      width: var(--paper-size, 58mm) !important;
      max-width: var(--paper-size, 58mm) !important;
      min-width: var(--paper-size, 58mm) !important;
      margin: 0 auto !important;
      padding: 2mm 3mm !important;
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 8.5pt !important;
    }
    div, main, .receipt-card {
      max-width: 100% !important;
      width: 100% !important;
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }
    * {
      color: #000000 !important;
    }
  }
</style>

<div class="max-w-md mx-auto space-y-4">
  <!-- Size Switcher -->
  <div class="no-print flex items-center justify-between bg-white px-4 py-2.5 rounded-2xl border border-slate-100 shadow-sm text-xs font-bold">
    <span class="text-slate-500"><i class="fas fa-print mr-1 text-indigo-600"></i> Mode Cetak Thermal:</span>
    <div class="flex items-center space-x-1.5">
      <button type="button" onclick="setPaperSize('58mm')" id="btn58" class="px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-[11px] font-bold">58mm</button>
      <button type="button" onclick="setPaperSize('80mm')" id="btn80" class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-[11px] font-bold hover:bg-slate-200">80mm</button>
    </div>
  </div>

  <!-- Thermal Receipt Card -->
  <div id="receiptContainer" class="receipt-card bg-white rounded-3xl p-6 card-shadow border border-slate-100 space-y-4">
    <!-- Receipt Header -->
    <div class="text-center pb-3 border-b border-dashed border-slate-300">
      <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-2 text-lg no-print">
        <i class="fas fa-wallet"></i>
      </div>
      <h2 class="text-sm font-black uppercase tracking-tight text-slate-900"><%= appName %></h2>
      <p class="text-[10px] text-slate-400 font-medium">BUKTI TRANSAKSI RESMI DIGITAL</p>
      <p class="text-[9px] text-slate-400 font-mono"><%= new Date(tx.createdAt).toLocaleDateString("id-ID", { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
    </div>

    <!-- Amount & Badge -->
    <div class="text-center my-2">
      <span class="inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider <%= tx.type === 'DEPOSIT' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
        <%= tx.type === 'DEPOSIT' ? 'SETORAN KAS (+)' : 'PENARIKAN KAS (-)' %>
      </span>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-1 font-mono">
        Rp <%= Math.abs(tx.amount).toLocaleString("id-ID") %>
      </h3>
      <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider mt-0.5">
        *** TRANSAKSI SUKSES ***
      </p>
    </div>

    <!-- Details -->
    <div class="py-2.5 border-t border-b border-dashed border-slate-300 space-y-1.5 text-[11px]">
      <div class="flex justify-between">
        <span class="text-slate-500">No. Referensi:</span>
        <span class="font-mono font-bold text-slate-800">TRX-<%= String(tx.id).padStart(6, '0') %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-500">Petugas Loket:</span>
        <span class="font-bold text-slate-800"><%= tx.cashier ? `${tx.cashier.role === 'ADMIN' ? 'Admin' : 'Kasir'} ${tx.cashier.name}` : 'Admin/Sistem' %></span>
      </div>

      <div class="pt-1.5 border-t border-slate-100 flex justify-between">
        <span class="text-slate-500">Nama Anggota:</span>
        <span class="font-bold text-slate-900"><%= tx.member.name %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-500">No. Rekening:</span>
        <span class="font-mono font-bold text-slate-800">
          <%= tx.member.accountNumber || ('TBG-2026-' + String(tx.member.id).padStart(4, '0')) %>
        </span>
      </div>

      <% if (tx.description) { %>
      <div class="flex justify-between">
        <span class="text-slate-500">Keterangan:</span>
        <span class="text-slate-700 font-medium truncate max-w-[150px]"><%= tx.description %></span>
      </div>
      <% } %>

      <div class="pt-1.5 border-t border-slate-200 flex justify-between items-center bg-slate-50 p-1.5 rounded-lg font-bold">
        <span class="text-slate-600 text-[10px]">TOTAL SALDO AKHIR:</span>
        <span class="font-mono text-emerald-800 text-xs">
          Rp <%= saldoSaatItu.toLocaleString("id-ID") %>
        </span>
      </div>
    </div>

    <!-- QR Code Verification -->
    <div class="flex flex-col items-center justify-center pt-1">
      <div id="receiptQr" class="p-1.5 bg-white border border-slate-200 rounded-lg"></div>
      <span class="text-[8px] text-slate-400 font-mono mt-1">Verifikasi Digital: TRX-<%= String(tx.id).padStart(6, '0') %></span>
    </div>

    <!-- Action Buttons -->
    <div class="no-print pt-3 space-y-2">
      <button
        onclick="window.print()"
        class="w-full py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center space-x-2"
      >
        <i class="fas fa-print"></i>
        <span>Cetak Struk Thermal</span>
      </button>
      <a
        href="/anggota/dashboard"
        class="block text-center py-2 text-xs font-semibold text-slate-500 hover:text-slate-800"
      >
        Kembali ke Dashboard
      </a>
    </div>
  </div>
</div>

<script>
  new QRCode(document.getElementById("receiptQr"), {
    text: "TRX-<%= String(tx.id).padStart(6, '0') %>|<%= tx.member.accountNumber || tx.member.id %>|<%= tx.amount %>",
    width: 64,
    height: 64,
    colorDark : "#000000",
    colorLight : "#ffffff",
    correctLevel : QRCode.CorrectLevel.M
  });

  function setPaperSize(size) {
    document.documentElement.style.setProperty('--paper-size', size);
    const btn58 = document.getElementById('btn58');
    const btn80 = document.getElementById('btn80');

    if (size === '58mm') {
      btn58.className = 'px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-[11px] font-bold';
      btn80.className = 'px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-[11px] font-bold hover:bg-slate-200';
    } else {
      btn80.className = 'px-2.5 py-1 rounded-xl bg-indigo-600 text-white text-[11px] font-bold';
      btn58.className = 'px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-[11px] font-bold hover:bg-slate-200';
    }
  }
</script>

<%- include("../layouts/footer") %>
